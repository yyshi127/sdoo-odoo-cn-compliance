        <field name="locator">第四条、第十五条至第十八条、第二十五条</field>
        <field name="claim_summary">税收征收管理法规定纳税人和扣缴义务人概念、税务登记及如实申报框架，为维护可追溯身份资料提供法定背景。</field>
        <field name="applicability_note">法条不能单独确定企业当前各税费种身份和申报频率，必须结合税务机关受控资料及其他现行规定。</field>
    </record>

    <record id="review_packet_cn_einvoice_reconciliation_ready_001_draft" model="sudo.cn.rule.review.packet">
        <field name="rule_version_id" ref="rule_version_cn_einvoice_reconciliation_ready_001_draft"/>
        <field name="scope_summary">适用于与评估期间完全一致的唯一当前成功账票勾稽批次；检查来源可用、数据缺口为零、待复核事项为零且确认依据未变化。</field>
