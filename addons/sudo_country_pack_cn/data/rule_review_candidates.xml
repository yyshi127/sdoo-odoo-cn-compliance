    <record id="review_packet_cn_vat_reconciliation_ready_001_draft" model="sudo.cn.rule.review.packet">
        <field name="rule_version_id" ref="rule_version_cn_vat_reconciliation_ready_001_draft"/>
        <field name="scope_summary">适用于与评估期间完全一致的唯一当前成功增值税四方勾稽批次；比较受控账务、电子发票、申报和缴款口径及差异事项。</field>
