        <field name="source_case_note">内部数据准备度反例，不是官方法律案例。</field>
    </record>

    <record id="rule_cn_iit_reconciliation_control_001" model="sudo.compliance.rule">
        <field name="name">个人所得税工资账表款差异复核控制</field>
        <field name="code">CN-IIT-RECON-CTRL-001</field>
        <field name="country_id" ref="base.cn"/>
        <field name="domain_key">CN.PAYROLL_IIT</field>
        <field name="cn_rule_nature">internal_control</field>
        <field name="description">在数据可比较时识别工资汇总、账务计提与结算、扣缴申报人数与金额、应补税与缴款以及应退税与退库之间的差异；数据阻断或仍有复核提示时返回待确认，不自动形成少缴税、违法、人员身份、扣除或税额计算结论。</field>
    </record>
    <record id="rule_version_cn_iit_reconciliation_control_001_draft" model="sudo.compliance.rule.version">
        <field name="rule_id" ref="rule_cn_iit_reconciliation_control_001"/>
        <field name="version">DRAFT-0.1</field>
        <field name="effective_from">2026-01-01</field>
        <field name="next_review_date">2026-10-15</field>
        <field name="evaluator_type">handler</field>
        <field name="handler_key">cn.iit.reconciliation.review.v1</field>
        <field name="handler_version">1</field>
        <field name="risk_level">high</field>
        <field name="stale_policy">block_all</field>
        <field name="authority_source_ids" eval="[(6, 0, [
            ref('source_cn_iit_law_2018_candidate'),
            ref('source_cn_iit_regulation_2018_candidate'),
            ref('source_cn_iit_withholding_measures_2018_candidate')
        ])]"/>
        <field name="required_fact_ids" eval="[(6, 0, [
            ref('fact_cn_iit_reconciliation_conclusion_state_v1'),
            ref('fact_cn_iit_reconciliation_blocking_count_v1'),
            ref('fact_cn_iit_reconciliation_difference_count_v1'),
            ref('fact_cn_iit_reconciliation_warning_count_v1'),
            ref('fact_cn_iit_reconciliation_detail_v1')
        ])]"/>
        <field name="legal_basis_summary">内部个人所得税差异复核控制草稿。候选官方来源仅提供纳税义务、扣缴义务、扣缴申报和缴纳的一般背景，尚未形成受控原文快照、独立复核和中国财税专业签核；系统差异不是税务认定或税款计算结果。</field>
        <field name="failure_message">受控工资、账务、个人所得税扣缴申报或缴退税来源存在一个或多个金额或人数差异项目，需要逐项专业复核。</field>
        <field name="pass_message">当前受控范围内未发现金额、人数差异或复核提示；该结果不证明人员身份、所得项目、扣除、税率、优惠、申报或缴税义务正确。</field>
        <field name="unknown_message">数据不可比较、状态与计数不一致或仍有复核提示，必须先由人工确认，不能作出通过判断。</field>
        <field name="recommended_actions">在个税勾稽批次中按稳定问题代码核对工资汇总、费用和应付职工薪酬计提、应交个人所得税、扣缴申报人数与金额、应补缴款、实际缴款、应退税和退库；记录每项差异原因、税务影响判断、责任人及证据后重新扫描。</field>
        <field name="evidence_required">个税勾稽批次及校验和、工资汇总审批依据、账务口径和账簿快照、扣缴申报与缴退税回执、人数及金额调节表、专业复核意见、整改证据和验证复扫结果。</field>
        <field name="requires_human_review">True</field>
    </record>
