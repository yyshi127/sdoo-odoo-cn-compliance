        <field name="country_id" ref="base.cn"/>
        <field name="domain_key">CN.PAYROLL_IIT</field>
        <field name="cn_rule_nature">data_readiness</field>
        <field name="description">检查同一主体和完全相同期间的已核验工资汇总、账务口径、个人所得税扣缴申报及缴退税来源是否具备受控比较条件。存在差异时仍可通过准备度检查，但差异必须由独立内控规则和专业人员继续复核。</field>
    </record>
    <record id="rule_version_cn_iit_reconciliation_ready_001_draft" model="sudo.compliance.rule.version">
        <field name="rule_id" ref="rule_cn_iit_reconciliation_ready_001"/>
        <field name="version">DRAFT-0.1</field>
        <field name="effective_from">2026-01-01</field>
        <field name="next_review_date">2026-10-15</field>
        <field name="evaluator_type">declarative</field>
        <field name="condition_json" eval="{
            'all': [
                {'fact': 'cn.reconciliation.iit.conclusion_state', 'operator': 'in', 'value': ['aligned', 'differences']},
                {'fact': 'cn.reconciliation.iit.blocking_issue_count', 'operator': 'eq', 'value': 0}
            ]
        }"/>
        <field name="match_result">pass</field>
        <field name="no_match_result">fail</field>
        <field name="risk_level">high</field>
        <field name="stale_policy">block_all</field>
        <field name="authority_source_ids" eval="[(6, 0, [
            ref('source_cn_iit_law_2018_candidate'),
            ref('source_cn_iit_regulation_2018_candidate'),
            ref('source_cn_iit_withholding_measures_2018_candidate')
        ])]"/>
        <field name="required_fact_ids" eval="[(6, 0, [
            ref('fact_cn_iit_reconciliation_conclusion_state_v1'),
            ref('fact_cn_iit_reconciliation_blocking_count_v1'),
            ref('fact_cn_iit_reconciliation_difference_count_v1'),
            ref('fact_cn_iit_reconciliation_warning_count_v1'),
            ref('fact_cn_iit_reconciliation_detail_v1')
        ])]"/>
        <field name="legal_basis_summary">内部个人所得税勾稽数据准备度控制草稿。候选官方来源尚未形成受控原文快照、独立复核和中国财税专业签核；通过仅表示当前受控工资、账务、扣缴申报和缴退税数据可以比较，不表示人员身份、所得项目、扣除、税额计算、申报或缴税正确。</field>
        <field name="failure_message">当前期间个人所得税勾稽存在来源缺失、口径未核验、结构版本不一致或审计完整性阻断，数据尚不可用于正式差异判断。</field>
        <field name="pass_message">当前期间工资汇总、账务、扣缴申报和缴退税来源已具备受控比较条件；金额、人数差异及复核提示仍须按后续内控规则处理。</field>
        <field name="unknown_message">没有可用的唯一当前成功个税勾稽结果，或结果正在重算、审计指纹异常，不能形成通过判断。</field>
        <field name="recommended_actions">打开事实快照关联的个税勾稽批次，按问题代码补齐工资汇总、账务口径、扣缴申报、缴款或退库来源并重新运行；不得把缺失值按零处理。</field>
        <field name="evidence_required">经核验的工资汇总、个税账务口径和账簿快照、扣缴申报回执、缴退税回执、来源校验和、数据准备复核记录及必要的访问控制记录。</field>
        <field name="requires_human_review">True</field>
    </record>
    <record id="test_cn_iit_reconciliation_ready_001_aligned" model="sudo.compliance.rule.test.case">
        <field name="name">个税勾稽来源完整且金额人数一致</field>
        <field name="rule_version_id" ref="rule_version_cn_iit_reconciliation_ready_001_draft"/>
        <field name="facts_json" eval="{
            'cn.reconciliation.iit.conclusion_state': 'aligned',
            'cn.reconciliation.iit.blocking_issue_count': 0
        }"/>
        <field name="evaluation_date">2026-07-16</field>
        <field name="expected_result">pass</field>
        <field name="source_case_note">内部数据准备度正例，不是官方法律案例。</field>
