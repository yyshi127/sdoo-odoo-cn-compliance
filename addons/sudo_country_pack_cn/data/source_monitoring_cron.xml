<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_cn_source_monitor_enqueue" model="ir.cron">
        <field name="name">中国官方来源到期检查排队</field>
        <field name="model_id" ref="model_sudo_cn_authority_source_monitor_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_enqueue_due_sources(limit=20)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_cn_source_monitor_process" model="ir.cron">
        <field name="name">中国官方来源远端变化检查</field>
        <field name="model_id" ref="model_sudo_cn_authority_source_monitor_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_runs(limit=2)</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
