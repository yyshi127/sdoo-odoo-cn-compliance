<odoo>
    <record id="cn_taxpayer_classification_company_rule" model="ir.rule">
        <field name="name">China taxpayer classifications: allowed companies</field>
        <field name="model_id" ref="model_sudo_cn_taxpayer_classification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sudo_global_finance.group_compliance_user'))]"/>
