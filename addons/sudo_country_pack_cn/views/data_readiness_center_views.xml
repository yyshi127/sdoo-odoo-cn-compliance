<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_data_readiness_center_search" model="ir.ui.view">
        <field name="name">sudo.cn.external.dataset.cn.data.readiness.search</field>
        <field name="model">sudo.cn.external.dataset</field>
        <field name="arch" type="xml">
            <search string="中国数据准备中心">
                <field name="name"/>
                <field name="company_id"/>
                <field name="profile_id"/>
                <field name="dataset_type"/>
                <field name="source_system_name"/>
                <field name="source_reference"/>
                <filter name="cn_profile_datasets" string="当前合规档案"
                        domain="[('profile_id', '!=', False)]"/>
                <filter name="draft" string="待补齐"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="sealed" string="已封存"
                        domain="[('state', '=', 'sealed')]"/>
                <filter name="authenticity_issue" string="真实性异常"
                        domain="[('authenticity_state', '=', 'official_tool_failed')]"/>
                <filter name="authenticity_unchecked" string="真实性待验证"
                        domain="[('authenticity_state', 'in', ('not_checked', 'unavailable'))]"/>
                <separator/>
                <filter name="group_dataset_type" string="按数据类型"
                        context="{'group_by': 'dataset_type'}"/>
                <filter name="group_state" string="按封存状态"
                        context="{'group_by': 'state'}"/>
                <filter name="group_company" string="按公司"
                        context="{'group_by': 'company_id'}"/>
                <filter name="group_period_end" string="按结束月份"
                        context="{'group_by': 'period_end:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_data_readiness_center_list" model="ir.ui.view">
        <field name="name">sudo.cn.external.dataset.cn.data.readiness.list</field>
        <field name="model">sudo.cn.external.dataset</field>
        <field name="arch" type="xml">
            <list string="中国数据准备中心"
                  decoration-danger="integrity_state == 'checksum_mismatch' or authenticity_state == 'official_tool_failed'"
                  decoration-warning="state == 'draft' or authenticity_state in ('not_checked', 'unavailable')"
                  decoration-success="state == 'sealed' and integrity_state == 'verified'">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="dataset_type"/>
                <field name="cn_data_readiness_period_label"/>
                <field name="cn_data_readiness_stage" widget="badge"
                       decoration-success="cn_data_readiness_stage == 'ready'"
                       decoration-warning="cn_data_readiness_stage in ('draft', 'sealed', 'warning')"
                       decoration-danger="cn_data_readiness_stage == 'blocked'"
                       decoration-muted="cn_data_readiness_stage == 'superseded'"/>
                <field name="declared_record_count"/>
                <field name="cn_data_readiness_record_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sealed'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'superseded'"/>
                <field name="integrity_state" widget="badge"
                       decoration-success="integrity_state == 'verified'"
                       decoration-warning="integrity_state == 'unsealed'"
                       decoration-danger="integrity_state == 'checksum_mismatch'"/>
                <field name="authenticity_state" widget="badge"
                       decoration-success="authenticity_state in ('official_tool_passed', 'not_applicable')"
                       decoration-warning="authenticity_state in ('not_checked', 'unavailable')"
                       decoration-danger="authenticity_state == 'official_tool_failed'"/>
                <field name="review_control_state" widget="badge"
                       decoration-success="review_control_state == 'independent'"
                       decoration-warning="review_control_state == 'pending'"
                       decoration-danger="review_control_state == 'exception'"/>
                <field name="parse_run_count" optional="show"/>
                <field name="tax_data_parse_run_count" optional="show"/>
                <field name="cn_data_readiness_next_action" optional="show"/>
                <field name="cn_data_readiness_blocker_summary" optional="show"/>
                <button name="action_view_parse_runs" type="object"
                        string="发票解析" class="btn-link"
                        invisible="dataset_type != 'electronic_invoice'"/>
                <button name="action_view_tax_data_parse_runs" type="object"
                        string="税务解析" class="btn-link"
                        invisible="dataset_type not in ('vat_filing', 'cit_filing', 'iit_withholding', 'payroll_summary', 'tax_payment')"/>
                <button name="action_view_normalized_tax_records" type="object"
                        string="规范化记录" class="btn-link"
                        invisible="dataset_type not in ('vat_filing', 'cit_filing', 'iit_withholding', 'payroll_summary', 'tax_payment')"/>
                <field name="profile_id" optional="hide"/>
                <field name="source_system_name" optional="hide"/>
                <field name="source_reference" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cn_data_readiness_center_kanban" model="ir.ui.view">
        <field name="name">sudo.cn.external.dataset.cn.data.readiness.kanban</field>
        <field name="model">sudo.cn.external.dataset</field>
        <field name="arch" type="xml">
            <kanban string="中国数据准备中心" class="o_kanban_dashboard"
                    create="0" quick_create="0" sample="0" default_group_by="dataset_type">
                <field name="name"/>
                <field name="company_id"/>
                <field name="dataset_type"/>
                <field name="cn_data_readiness_period_label"/>
                <field name="cn_data_readiness_stage"/>
                <field name="cn_data_readiness_record_count"/>
                <field name="cn_data_readiness_next_action"/>
                <field name="cn_data_readiness_blocker_summary"/>
                <field name="declared_record_count"/>
                <field name="state"/>
                <field name="integrity_state"/>
                <field name="authenticity_state"/>
                <field name="review_control_state"/>
                <field name="parse_run_count"/>
                <field name="tax_data_parse_run_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click shadow-sm border-start border-4 #{record.cn_data_readiness_stage.raw_value == 'blocked' ? 'border-danger' : record.cn_data_readiness_stage.raw_value == 'ready' ? 'border-success' : 'border-warning'}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold"><field name="name"/></div>
                                    <div class="text-muted small">
                                        <field name="company_id"/>
                                        <span> / </span>
                                        <field name="cn_data_readiness_period_label"/>
                                    </div>
                                </div>
                                <field name="cn_data_readiness_stage" widget="badge"
                                       decoration-success="cn_data_readiness_stage == 'ready'"
                                       decoration-warning="cn_data_readiness_stage in ('draft', 'sealed', 'warning')"
                                       decoration-danger="cn_data_readiness_stage == 'blocked'"
                                       decoration-muted="cn_data_readiness_stage == 'superseded'"/>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="text-muted small">下一步</div>
                                <div class="fw-semibold"><field name="cn_data_readiness_next_action"/></div>
                                <div class="text-muted small mt-1">Blockers</div>
                                <div class="small"><field name="cn_data_readiness_blocker_summary"/></div>
                            </div>
                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">源记录</div>
                                        <div class="fw-bold"><field name="declared_record_count"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">规范化</div>
                                        <div class="fw-bold"><field name="cn_data_readiness_record_count"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">封存</div>
                                        <field name="state" widget="badge"
                                               decoration-success="state == 'sealed'"
                                               decoration-warning="state == 'draft'"
                                               decoration-muted="state == 'superseded'"/>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">完整性</div>
                                        <field name="integrity_state" widget="badge"
                                               decoration-success="integrity_state == 'verified'"
                                               decoration-warning="integrity_state == 'unsealed'"
                                               decoration-danger="integrity_state == 'checksum_mismatch'"/>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">真实性</div>
                                        <field name="authenticity_state" widget="badge"
                                               decoration-success="authenticity_state in ('official_tool_passed', 'not_applicable')"
                                               decoration-warning="authenticity_state in ('not_checked', 'unavailable')"
                                               decoration-danger="authenticity_state == 'official_tool_failed'"/>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">复核控制</div>
                                        <field name="review_control_state" widget="badge"
                                               decoration-success="review_control_state == 'independent'"
                                               decoration-warning="review_control_state == 'pending'"
                                               decoration-danger="review_control_state == 'exception'"/>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button name="action_view_parse_runs" type="object"
                                        class="btn btn-outline-primary btn-sm"
                                        invisible="dataset_type != 'electronic_invoice'">
                                    发票解析
                                </button>
                                <button name="action_view_tax_data_parse_runs" type="object"
                                        class="btn btn-outline-primary btn-sm"
                                        invisible="dataset_type not in ('vat_filing', 'cit_filing', 'iit_withholding', 'payroll_summary', 'tax_payment')">
                                    税务解析
                                </button>
                                <button name="action_view_normalized_documents" type="object"
                                        class="btn btn-outline-secondary btn-sm"
                                        invisible="dataset_type != 'electronic_invoice'">
                                    发票台账
                                </button>
                                <button name="action_view_normalized_tax_records" type="object"
                                        class="btn btn-outline-secondary btn-sm"
                                        invisible="dataset_type not in ('vat_filing', 'cit_filing', 'iit_withholding', 'payroll_summary', 'tax_payment')">
                                    规范化记录
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_cn_data_readiness_center" model="ir.actions.act_window">
        <field name="name">中国数据准备中心</field>
        <field name="res_model">sudo.cn.external.dataset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_cn_data_readiness_center_search"/>
        <field name="context">{'search_default_group_dataset_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">尚未登记受控数据集</p>
            <p>先登记电子发票、申报、缴款、工资等受控数据来源，封存并解析后，再进入风险扫描和报告出具。</p>
        </field>
    </record>

    <record id="action_cn_data_readiness_center_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_cn_data_readiness_center_kanban"/>
        <field name="act_window_id" ref="action_cn_data_readiness_center"/>
    </record>

    <record id="action_cn_data_readiness_center_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_cn_data_readiness_center_list"/>
        <field name="act_window_id" ref="action_cn_data_readiness_center"/>
    </record>

    <record id="action_cn_data_readiness_center_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_cn_external_dataset_form"/>
        <field name="act_window_id" ref="action_cn_data_readiness_center"/>
    </record>

    <menuitem id="menu_cn_data_readiness_center"
              name="中国数据准备中心"
              parent="sudo_global_finance.menu_global_finance_root"
              action="action_cn_data_readiness_center"
              sequence="31"
              groups="sudo_global_finance.group_compliance_user"/>
</odoo>
