<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_rule_review_packet_list" model="ir.ui.view">
        <field name="name">sudo.cn.rule.review.packet.list</field>
        <field name="model">sudo.cn.rule.review.packet</field>
        <field name="arch" type="xml">
            <list string="中国专业复核包" create="0" delete="0">
                <field name="rule_version_id"/>
                <field name="cn_rule_nature" widget="badge"/>
                <field name="readiness_state" widget="badge"
                       decoration-success="readiness_state == 'ready'"
                       decoration-warning="readiness_state == 'incomplete'"/>
                <field name="test_state" widget="badge"/>
                <field name="professional_review_state" widget="badge"/>
                <field name="candidate_checksum" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cn_rule_review_packet_form" model="ir.ui.view">
        <field name="name">sudo.cn.rule.review.packet.form</field>
        <field name="model">sudo.cn.rule.review.packet</field>
        <field name="arch" type="xml">
            <form string="中国专业复核包" create="0" delete="0">
                <header>
                    <button name="action_print_review_packet" type="object"
                            string="打印专业复核包" icon="fa-print"
                            class="btn-primary"/>
                    <field name="readiness_state" widget="statusbar"
                           statusbar_visible="incomplete,ready"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>候选材料：</strong>
                        本复核包用于真人中国财税专业人员审阅，不是法律意见、税务认定或已批准规则。
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rule_version_id" readonly="1"/>
                            <field name="cn_rule_nature" widget="badge" readonly="1"/>
                            <field name="rule_version_state" widget="badge" readonly="1"/>
                        </group>
                        <group>
                            <field name="test_state" widget="badge" readonly="1"/>
                            <field name="professional_review_state" widget="badge" readonly="1"/>
                            <field name="candidate_checksum" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="readiness_state == 'ready'">
                        <strong>材料缺口</strong>
                        <field name="readiness_blockers" nolabel="1" readonly="1"/>
                    </div>
                    <notebook>
                        <page string="适用范围与边界">
                            <group>
                                <field name="scope_summary"
                                       readonly="rule_version_state != 'draft'"/>
                                <field name="applicability_assumptions"
                                       readonly="rule_version_state != 'draft'"/>
                                <field name="exclusions_limitations"
                                       readonly="rule_version_state != 'draft'"/>
                                <field name="conclusion_boundary"
                                       readonly="rule_version_state != 'draft'"/>
                            </group>
                        </page>
                        <page string="条款定位">
                            <field name="citation_ids"
                                   readonly="rule_version_state != 'draft'">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_id"/>
                                    <field name="citation_type" widget="badge"/>
                                    <field name="locator"/>
                                    <field name="claim_summary" optional="show"/>
                                    <field name="applicability_note" optional="hide"/>
                                </list>
                                <form string="条款定位">
                                    <group>
                                        <group>
                                            <field name="source_id"
                                                   options="{'no_create': True}"/>
                                            <field name="citation_type"/>
                                            <field name="locator"/>
                                            <field name="sequence"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="claim_summary"/>
                                        <field name="applicability_note"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="专业审阅问题">
                            <field name="reviewer_questions"
                                   readonly="rule_version_state != 'draft'"/>
                            <separator string="签核说明"/>
                            <p class="text-muted">
                                专业人员应核对官方快照、条款定位、企业适用性、测试案例和结论边界；正式意见及证据 SHA-256 在规则版本的“专业签核”页记录。
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
