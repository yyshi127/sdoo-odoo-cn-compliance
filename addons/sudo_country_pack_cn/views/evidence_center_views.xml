<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_evidence_center_search" model="ir.ui.view">
        <field name="name">sudo.compliance.evidence.cn.center.search</field>
        <field name="model">sudo.compliance.evidence</field>
        <field name="arch" type="xml">
            <search string="中国证据中心">
                <field name="name"/>
                <field name="company_id"/>
                <field name="evidence_type"/>
                <field name="state"/>
                <field name="issuer"/>
                <field name="assessment_id"/>
                <field name="finding_id"/>
                <field name="task_id"/>
                <field name="filing_id"/>
                <filter name="cn_related" string="中国相关证据"
                        domain="['|', '|', '|', ('assessment_id.country_id.code', '=', 'CN'), ('finding_id.assessment_id.country_id.code', '=', 'CN'), ('task_id.assessment_id.country_id.code', '=', 'CN'), ('filing_id.country_id.code', '=', 'CN')]"/>
                <filter name="pending" string="待验证"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="verified" string="已验证"
                        domain="[('state', '=', 'verified')]"/>
                <filter name="rejected" string="已退回"
                        domain="[('state', '=', 'rejected')]"/>
                <filter name="external_reference" string="外部档案"
                        domain="[('evidence_type', '=', 'external_reference')]"/>
                <filter name="filing_receipt" string="申报回执"
                        domain="[('evidence_type', '=', 'filing_receipt')]"/>
                <filter name="payment_proof" string="缴款证明"
                        domain="[('evidence_type', '=', 'payment_proof')]"/>
                <filter name="remediation_proof" string="整改证明"
                        domain="[('evidence_type', '=', 'remediation_proof')]"/>
                <separator/>
                <filter name="group_state" string="按状态"
                        context="{'group_by': 'state'}"/>
                <filter name="group_type" string="按证据类型"
                        context="{'group_by': 'evidence_type'}"/>
                <filter name="group_company" string="按公司"
                        context="{'group_by': 'company_id'}"/>
                <filter name="group_date" string="按证据月份"
                        context="{'group_by': 'evidence_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_evidence_center_list" model="ir.ui.view">
        <field name="name">sudo.compliance.evidence.cn.center.list</field>
        <field name="model">sudo.compliance.evidence</field>
        <field name="arch" type="xml">
            <list string="中国证据中心" delete="0"
                  decoration-success="state == 'verified'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="evidence_type" widget="badge"/>
                <field name="evidence_date"/>
                <field name="issuer" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'verified'"
                       decoration-warning="state == 'submitted'"
                       decoration-danger="state == 'rejected'"/>
                <field name="cn_evidence_source_summary" optional="show"/>
                <field name="cn_evidence_blocker_summary" optional="show"/>
                <field name="assessment_id" optional="hide"/>
                <field name="finding_id" optional="hide"/>
                <field name="task_id" optional="show"/>
                <field name="filing_id" optional="show"/>
                <field name="document_checksum" optional="show"/>
                <field name="submitted_by_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="verified_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="verified_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_cn_evidence_center_kanban" model="ir.ui.view">
        <field name="name">sudo.compliance.evidence.cn.center.kanban</field>
        <field name="model">sudo.compliance.evidence</field>
        <field name="arch" type="xml">
            <kanban string="中国证据中心" class="o_kanban_dashboard"
                    create="0" quick_create="0" sample="0" default_group_by="state">
                <field name="name"/>
                <field name="company_id"/>
                <field name="evidence_type"/>
                <field name="evidence_date"/>
                <field name="issuer"/>
                <field name="state"/>
                <field name="assessment_id"/>
                <field name="finding_id"/>
                <field name="task_id"/>
                <field name="filing_id"/>
                <field name="document_checksum"/>
                <field name="cn_evidence_source_summary"/>
                <field name="cn_evidence_blocker_summary"/>
                <field name="verified_by_id"/>
                <field name="verified_at"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click shadow-sm border-start border-4 #{record.state.raw_value == 'verified' ? 'border-success' : record.state.raw_value == 'submitted' ? 'border-warning' : record.state.raw_value == 'rejected' ? 'border-danger' : 'border-secondary'}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold"><field name="name"/></div>
                                    <div class="text-muted small">
                                        <field name="company_id"/>
                                        <span> · </span>
                                        <field name="evidence_date"/>
                                    </div>
                                </div>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'verified'"
                                       decoration-warning="state == 'submitted'"
                                       decoration-danger="state == 'rejected'"/>
                            </div>
                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">证据类型</div>
                                        <div class="fw-semibold"><field name="evidence_type" widget="badge"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">出具方</div>
                                        <div class="fw-semibold"><field name="issuer"/></div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 small text-muted">
                                <span>SHA-256：</span>
                                <field name="document_checksum"/>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="text-muted small">Source</div>
                                <div class="fw-semibold">
                                    <field name="cn_evidence_source_summary"/>
                                </div>
                                <div class="text-muted small mt-1">Blockers</div>
                                <div class="small">
                                    <field name="cn_evidence_blocker_summary"/>
                                </div>
                            </div>
                            <div class="mt-3 small">
                                <div invisible="not task_id">整改任务：<field name="task_id"/></div>
                                <div invisible="not filing_id">申报/缴款档案：<field name="filing_id"/></div>
                                <div invisible="not finding_id">风险事项：<field name="finding_id"/></div>
                                <div invisible="not assessment_id">规则扫描：<field name="assessment_id"/></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <field name="verified_by_id" widget="many2one_avatar_user"/>
                                <field name="verified_at"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cn_evidence_center_form_inherit" model="ir.ui.view">
        <field name="name">sudo.compliance.evidence.cn.center.form</field>
        <field name="model">sudo.compliance.evidence</field>
        <field name="inherit_id" ref="sudo_global_finance.view_compliance_evidence_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="alert alert-info" role="alert">
                    证据提交后会冻结文件或外部档案索引的 SHA-256；已提交或已验证证据不得直接修改或删除。
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_cn_evidence_center" model="ir.actions.act_window">
        <field name="name">中国证据中心</field>
        <field name="res_model">sudo.compliance.evidence</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_cn_evidence_center_search"/>
        <field name="domain">['|', '|', '|', ('assessment_id.country_id.code', '=', 'CN'), ('finding_id.assessment_id.country_id.code', '=', 'CN'), ('task_id.assessment_id.country_id.code', '=', 'CN'), ('filing_id.country_id.code', '=', 'CN')]</field>
        <field name="context">{'search_default_cn_related': 1, 'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有中国合规证据</p>
            <p>从风险事项、整改任务、规则扫描或申报缴款档案中新增证据，并在这里跟踪提交、验证和退回状态。</p>
        </field>
    </record>

    <record id="action_cn_evidence_center_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_cn_evidence_center_kanban"/>
        <field name="act_window_id" ref="action_cn_evidence_center"/>
    </record>

    <record id="action_cn_evidence_center_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_cn_evidence_center_list"/>
        <field name="act_window_id" ref="action_cn_evidence_center"/>
    </record>

    <record id="action_cn_evidence_center_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sudo_global_finance.view_compliance_evidence_form"/>
        <field name="act_window_id" ref="action_cn_evidence_center"/>
    </record>

    <menuitem id="menu_cn_evidence_center"
              name="中国证据中心"
              parent="sudo_global_finance.menu_global_finance_root"
              action="action_cn_evidence_center"
              sequence="28"
              groups="sudo_global_finance.group_compliance_user"/>
</odoo>
