<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_einvoice_reconciliation_case_search"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.reconciliation.case.search</field>
        <field name="model">sudo.cn.einvoice.reconciliation.case</field>
        <field name="arch" type="xml">
            <search string="账票勾稽">
                <field name="invoice_number"/>
                <field name="seller_name"/>
                <field name="seller_tax_id"/>
                <field name="run_id"/>
                <field name="company_id"/>
                <filter name="current" string="当前勾稽结果"
                        domain="[('is_current_run', '=', True)]"/>
                <separator/>
                <filter name="needs_attention" string="需要处理"
                        domain="[('state', 'not in', ('matched', 'reviewed_unmatched'))]"/>
                <filter name="data_gap" string="数据缺口"
                        domain="[('state', '=', 'data_gap')]"/>
                <filter name="unmatched" string="未匹配"
                        domain="[('state', 'in', ('unmatched', 'reviewed_unmatched'))]"/>
                <filter name="suggested" string="待确认建议"
                        domain="[('state', '=', 'suggested')]"/>
                <filter name="ambiguous" string="多候选"
                        domain="[('state', '=', 'ambiguous')]"/>
                <filter name="matched" string="已匹配"
                        domain="[('state', '=', 'matched')]"/>
                <separator/>
                <filter name="group_state" string="当前状态"
                        context="{'group_by': 'state'}"/>
                <filter name="group_seller" string="销售方"
                        context="{'group_by': 'seller_tax_id'}"/>
                <filter name="group_run" string="勾稽批次"
                        context="{'group_by': 'run_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_einvoice_reconciliation_case_list"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.reconciliation.case.list</field>
        <field name="model">sudo.cn.einvoice.reconciliation.case</field>
        <field name="arch" type="xml">
            <list string="账票勾稽" create="0" edit="0" delete="0"
                  decoration-success="state == 'matched' and decision_integrity_state != 'mismatch'"
                  decoration-danger="state == 'data_gap' or decision_integrity_state == 'mismatch'"
                  decoration-warning="state in ('unmatched', 'suggested', 'ambiguous', 'partial')"
                  decoration-muted="not is_current_run">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="invoice_number"/>
                <field name="request_time"/>
                <field name="seller_name"/>
                <field name="seller_tax_id" optional="show"/>
                <field name="currency_id"/>
                <field name="total_amount" sum="发票合计"/>
                <field name="tax_amount" sum="税额合计" optional="show"/>
                <field name="candidate_count"/>
                <field name="high_confidence_count"/>
                <field name="confirmed_candidate_count"/>
                <field name="blocking_issue_count" optional="show"/>
                <field name="warning_issue_count" optional="show"/>
                <field name="match_mode" widget="badge" optional="show"/>
                <field name="decision_integrity_state" widget="badge"
                       decoration-success="decision_integrity_state == 'verified'"
                       decoration-danger="decision_integrity_state == 'mismatch'"
                       decoration-muted="decision_integrity_state == 'not_matched'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'matched'"
                       decoration-danger="state == 'data_gap'"
                       decoration-warning="state in ('unmatched','suggested','ambiguous','partial')"
                       decoration-muted="state == 'reviewed_unmatched'"/>
                <field name="run_id" optional="hide"/>
                <field name="is_current_run" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cn_einvoice_reconciliation_case_form"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.reconciliation.case.form</field>
        <field name="model">sudo.cn.einvoice.reconciliation.case</field>
        <field name="arch" type="xml">
            <form string="账票勾稽事项" create="0" edit="0" delete="0">
                <header>
                    <field name="can_manual_match" invisible="1"/>
                    <button name="action_open_manual_match" type="object"
                            string="人工指定凭证" class="btn-primary"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="not can_manual_match"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="data_gap,unmatched,suggested,ambiguous,partial,matched,reviewed_unmatched"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="非当前勾稽结果"
                            bg_color="text-bg-secondary"
                            invisible="is_current_run"/>
                    <widget name="web_ribbon" title="确认后账簿已变化"
                            bg_color="text-bg-danger"
                            invisible="decision_integrity_state != 'mismatch'"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'data_gap'">
                        源发票存在关键数据缺口或会计主体不一致，系统没有生成自动匹配建议。请先修复数据来源后重新解析和勾稽。
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state not in ('unmatched', 'ambiguous', 'partial')">
                        当前事项仍需人工处理。候选建议不构成会计或税务结论，确认前请核对原始发票和已过账凭证。
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="warning_issue_count == 0 or state == 'data_gap'">
                        当前源数据存在非阻断警告。确认候选前请核对真实性、覆盖范围、公司识别信息和复核限制。
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'suggested'">
                        系统找到一个高可信候选。请核对编号、往来方、金额、税额、日期和凭证状态后人工确认。
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'matched' or decision_integrity_state == 'mismatch'">
                        该事项已人工确认匹配，且确认所依据的 Odoo 凭证快照未发生变化。
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="电子发票">
                            <field name="einvoice_document_id"/>
                            <field name="invoice_number"/>
                            <field name="request_time"/>
                            <field name="seller_name"/>
                            <field name="seller_tax_id"/>
                            <field name="source_quality_state" widget="badge"/>
                        </group>
                        <group string="勾稽结论">
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="total_amount"/>
                            <field name="tax_amount"/>
                            <field name="initial_state" widget="badge"/>
                            <field name="match_mode" widget="badge"/>
                            <field name="decision_integrity_state"
                                   widget="badge"/>
                        </group>
                    </group>
                    <group string="处理概览">
                        <field name="candidate_count"/>
                        <field name="high_confidence_count"/>
                        <field name="confirmed_candidate_count"/>
                        <field name="blocking_issue_count"/>
                        <field name="warning_issue_count"/>
                        <field name="reviewed_at"/>
                        <field name="reviewed_by_id"/>
                        <field name="run_id"/>
                    </group>
                    <field name="data_gap_summary"
                           invisible="not data_gap_summary"/>
                    <notebook>
                        <page string="匹配候选">
                            <field name="candidate_ids">
                                <list create="0" edit="0" delete="0"
                                      decoration-success="state=='confirmed' and integrity_state=='verified'"
                                      decoration-danger="integrity_state == 'mismatch'"
                                      decoration-muted="state == 'rejected'">
                                    <field name="source_scope" widget="badge"/>
                                    <field name="source_accounting_document_id"
                                           optional="show"/>
                                    <field name="score"/>
                                    <field name="confidence" widget="badge"
                                           decoration-success="confidence == 'high'"
                                           decoration-warning="confidence in ('medium', 'manual')"
                                           decoration-muted="confidence == 'low'"/>
                                    <field name="move_name_snapshot"/>
                                    <field name="move_reference_snapshot"
                                           optional="show"/>
                                    <field name="move_type_snapshot"/>
                                    <field name="move_state_snapshot"
                                           widget="badge"
                                           decoration-success="move_state_snapshot == 'posted'"
                                           decoration-warning="move_state_snapshot == 'draft'"/>
                                    <field name="move_partner_name_snapshot"/>
                                    <field name="move_date_snapshot"/>
                                    <field name="move_total_snapshot"/>
                                    <field name="total_difference"
                                           optional="show"/>
                                    <field name="tax_difference"
                                           optional="show"/>
                                    <field name="date_difference_days"
                                           optional="show"/>
                                    <field name="reason_summary"
                                           optional="show"/>
                                    <field name="integrity_state" widget="badge"
                                           decoration-success="integrity_state == 'verified'"
                                           decoration-danger="integrity_state == 'mismatch'"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'confirmed'"
                                           decoration-muted="state == 'rejected'"/>
                                    <field name="can_confirm"
                                           column_invisible="1"/>
                                    <button name="action_confirm" type="object"
                                            icon="fa-check" title="确认匹配"
                                            groups="sudo_global_finance.group_compliance_manager"
                                            invisible="not can_confirm"/>
                                    <button name="action_reject" type="object"
                                            icon="fa-times" title="拒绝候选"
                                            groups="sudo_global_finance.group_compliance_manager"
                                            invisible="state != 'proposed'"/>
                                    <button name="action_reset_decision"
                                            type="object" icon="fa-undo"
                                            title="撤销决策"
                                            groups="sudo_global_finance.group_compliance_manager"
                                            invisible="state == 'proposed'"/>
                                    <button name="action_open_move" type="object"
                                            icon="fa-external-link"
                                            title="打开 Odoo 凭证"
                                            groups="account.group_account_readonly"/>
                                </list>
                                <form string="账票匹配候选"
                                      create="0" edit="0" delete="0">
                                    <header>
                                        <field name="can_confirm" invisible="1"/>
                                        <button name="action_confirm"
                                                type="object" string="确认匹配"
                                                class="btn-primary"
                                                groups="sudo_global_finance.group_compliance_manager"
                                                invisible="not can_confirm"/>
                                        <button name="action_reject"
                                                type="object" string="拒绝候选"
                                                groups="sudo_global_finance.group_compliance_manager"
                                                invisible="state != 'proposed'"/>
                                        <button name="action_reset_decision"
                                                type="object" string="撤销决策"
                                                groups="sudo_global_finance.group_compliance_manager"
                                                invisible="state == 'proposed'"/>
                                        <field name="state" widget="statusbar"
                                               readonly="1"
                                               statusbar_visible="proposed,confirmed,rejected"/>
                                    </header>
                                    <sheet>
                                        <div class="alert alert-danger"
                                             role="alert"
                                             invisible="integrity_state != 'mismatch'">
                                            Odoo 凭证在扫描后已经变化。本候选不得确认，请重新运行账票勾稽。
                                        </div>
                                        <group>
                                            <group string="候选依据">
                                                <field name="source_scope"/>
                                                <field name="source_accounting_document_id"/>
                                                <field name="origin"/>
                                                <field name="score"/>
                                                <field name="confidence"
                                                       widget="badge"/>
                                                <field name="reason_summary"/>
                                                <field name="reason_json"/>
                                            </group>
                                            <group string="Odoo 凭证快照">
                                                <field name="move_id"
                                                       groups="account.group_account_readonly"/>
                                                <field name="move_name_snapshot"/>
                                                <field name="move_reference_snapshot"/>
                                                <field name="move_type_snapshot"/>
                                                <field name="move_state_snapshot"/>
                                                <field name="move_date_snapshot"/>
                                                <field name="move_partner_name_snapshot"/>
                                                <field name="move_partner_vat_snapshot"/>
                                                <field name="integrity_state"
                                                       widget="badge"/>
                                            </group>
                                        </group>
                                        <group string="金额与日期差异">
                                            <group>
                                                <field name="move_currency_id"/>
                                                <field name="move_total_snapshot"/>
                                                <field name="move_tax_snapshot"/>
                                                <field name="move_company_currency_id"/>
                                                <field name="move_debit_snapshot"/>
                                                <field name="move_credit_snapshot"/>
                                            </group>
                                            <group>
                                                <field name="invoice_number_match"/>
                                                <field name="partner_match"/>
                                                <field name="currency_match"/>
                                                <field name="total_difference"
                                                       invisible="not has_total_difference"/>
                                                <field name="tax_difference"
                                                       invisible="not has_tax_difference"/>
                                                <field name="date_difference_days"/>
                                            </group>
                                        </group>
                                        <group string="决策记录">
                                            <field name="reviewed_at"/>
                                            <field name="reviewed_by_id"/>
                                            <field name="review_note"/>
                                            <field name="move_snapshot_checksum"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="数据缺口与溯源">
                            <field name="data_gap_json"/>
                            <group>
                                <field name="run_id"/>
                                <field name="is_current_run"/>
                                <field name="confirmed_move_ids"
                                       groups="account.group_account_readonly"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cn_einvoice_reconciliation_run_search"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.reconciliation.run.search</field>
        <field name="model">sudo.cn.einvoice.reconciliation.run</field>
        <field name="arch" type="xml">
            <search string="账票勾稽批次">
                <field name="profile_id"/>
                <field name="company_id"/>
                <filter name="current" string="当前成功批次"
                        domain="[('state', '=', 'succeeded')]"/>
                <filter name="active" string="待处理与处理中"
                        domain="[('state', 'in', ('queued', 'processing'))]"/>
                <filter name="failed" string="失败"
                        domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="group_state" string="状态"
                        context="{'group_by': 'state'}"/>
                <filter name="group_profile" string="合规档案"
                        context="{'group_by': 'profile_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_einvoice_reconciliation_run_list"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.reconciliation.run.list</field>
        <field name="model">sudo.cn.einvoice.reconciliation.run</field>
        <field name="arch" type="xml">
            <list string="账票勾稽批次" create="0" edit="0" delete="0"
                  decoration-success="state == 'succeeded'"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state in ('queued', 'processing')"
                  decoration-muted="state in ('cancelled', 'superseded')">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="profile_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="source_availability_state" widget="badge"
                       decoration-success="source_availability_state == 'available'"
                       decoration-danger="source_availability_state == 'blocked'"
                       decoration-warning="source_availability_state == 'no_data'"
                       decoration-muted="source_availability_state == 'not_evaluated'"/>
                <field name="source_document_count"/>
                <field name="case_count"/>
                <field name="matched_case_count"/>
                <field name="suggested_case_count"/>
                <field name="ambiguous_case_count"/>
                <field name="unmatched_case_count"/>
                <field name="data_gap_case_count"/>
                <field name="warning_case_count"/>
                <field name="requested_at" optional="show"/>
                <field name="requested_by_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'succeeded'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state in ('queued', 'processing')"
                       decoration-muted="state in ('cancelled', 'superseded')"/>
            </list>
        </field>
    </record>

    <record id="view_cn_einvoice_reconciliation_run_form"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.reconciliation.run.form</field>
        <field name="model">sudo.cn.einvoice.reconciliation.run</field>
        <field name="arch" type="xml">
            <form string="账票勾稽批次" create="0" edit="0" delete="0">
                <header>
                    <button name="action_queue_compliance_assessment"
                            type="object" string="发起规则扫描"
                            class="btn-primary"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="state != 'succeeded'"/>
                    <button name="action_cancel" type="object"
                            string="取消待处理批次"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="state != 'queued'"/>
                    <field name="state" widget="statusbar" readonly="1"
                    statusbar_visible="queued,processing,succeeded,failed,cancelled,superseded"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="已被新批次替代"
                            bg_color="text-bg-secondary"
                            invisible="state != 'superseded'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_cases" type="object"
                                class="oe_stat_button" icon="fa-balance-scale"
                                invisible="case_count == 0">
                            <field name="case_count" widget="statinfo"
                                   string="勾稽事项"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state not in ('queued', 'processing')">
                        后台正在读取当前有效电子发票台账和 Odoo 会计凭证。系统只生成候选，不会自动修改或确认会计数据。
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'failed'">
                        本次勾稽失败且没有替代上一份成功结果。请查看失败代码，修复数据范围或账簿后重新提交。
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'succeeded' or source_availability_state != 'no_data'">
                        技术任务已完成，但所选期间没有当前有效电子发票。该结果不能解释为账票一致或没有风险。
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="engine_version"/>
                            <field name="source_availability_state"
                                   widget="badge"/>
                        </group>
                        <group>
                            <field name="requested_at"/>
                            <field name="requested_by_id"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="error_code"
                                   invisible="not error_code"/>
                        </group>
                    </group>
                    <group string="结果概览">
                        <group>
                            <field name="source_document_count"/>
                            <field name="ledger_move_count"/>
                            <field name="case_count"/>
                            <field name="matched_case_count"/>
                        </group>
                        <group>
                            <field name="suggested_case_count"/>
                            <field name="ambiguous_case_count"/>
                            <field name="unmatched_case_count"/>
                            <field name="data_gap_case_count"/>
                            <field name="warning_case_count"/>
                        </group>
                    </group>
                    <field name="result_summary"/>
                    <group string="审计指纹">
                        <field name="source_snapshot_checksum"/>
                        <field name="ledger_snapshot_checksum"/>
                        <field name="result_checksum"/>
                    </group>
                    <notebook>
                        <page string="账票勾稽事项">
                            <field name="case_ids">
                                <list create="0" edit="0" delete="0"
                                      decoration-success="state == 'matched'"
                                      decoration-danger="state == 'data_gap'"
                                      decoration-warning="state in ('unmatched','suggested','ambiguous','partial')">
                                    <field name="invoice_number"/>
                                    <field name="seller_name"/>
                                    <field name="request_time"/>
                                    <field name="total_amount"/>
                                    <field name="candidate_count"/>
                                    <field name="confirmed_candidate_count"/>
                                    <field name="blocking_issue_count"/>
                                    <field name="warning_issue_count"/>
                                    <field name="decision_integrity_state"
                                           widget="badge"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cn_einvoice_reconciliation_wizard_form"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.reconciliation.wizard.form</field>
        <field name="model">sudo.cn.einvoice.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="发起账票勾稽">
                <div class="alert alert-info" role="alert">
                    批次在后台执行。系统读取当前有效电子发票台账和所选期间附近的 Odoo 账簿，只生成可解释候选并保留快照，不会自动确认或修改会计凭证。
                </div>
                <group>
                    <field name="profile_id" options="{'no_create': True}"/>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                </group>
                <footer>
                    <button name="action_queue" type="object"
                            string="提交后台勾稽" class="btn-primary"/>
                    <button string="取消" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_cn_einvoice_manual_match_wizard_form"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.manual.match.wizard.form</field>
        <field name="model">sudo.cn.einvoice.manual.match.wizard</field>
        <field name="arch" type="xml">
            <form string="人工指定 Odoo 凭证">
                <div class="alert alert-warning" role="alert">
                    人工指定会直接形成确认关系。请先打开并核对已过账 Odoo 凭证，说明为什么自动候选不足或不适用。
                </div>
                <group>
                    <field name="case_id" readonly="1"/>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                    <field name="available_accounting_document_ids"
                           invisible="1"/>
                    <field name="source_scope"/>
                    <field name="source_accounting_document_id"
                           domain="[('id', 'in', available_accounting_document_ids)]"
                           options="{'no_create': True}"
                           invisible="source_scope != 'voucher'"
                           required="source_scope == 'voucher'"/>
                    <field name="move_id" options="{'no_create': True}"/>
                    <field name="note"
                           placeholder="说明原始发票、Odoo 凭证及人工判断依据..."/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="确认人工匹配" class="btn-primary"/>
                    <button string="取消" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cn_einvoice_reconciliation_cases"
            model="ir.actions.act_window">
        <field name="name">账票勾稽</field>
        <field name="res_model">sudo.cn.einvoice.reconciliation.case</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_cn_einvoice_reconciliation_case_search"/>
        <field name="context"
               eval="{'search_default_current': 1, 'search_default_needs_attention': 1}"/>
    </record>

    <record id="action_cn_einvoice_reconciliation_runs"
            model="ir.actions.act_window">
        <field name="name">账票勾稽批次</field>
        <field name="res_model">sudo.cn.einvoice.reconciliation.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_cn_einvoice_reconciliation_run_search"/>
    </record>

    <record id="action_cn_einvoice_reconciliation_wizard"
            model="ir.actions.act_window">
        <field name="name">发起账票勾稽</field>
        <field name="res_model">sudo.cn.einvoice.reconciliation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cn_einvoice_reconciliation_cases"
              name="账票勾稽"
              parent="sudo_global_finance.menu_compliance_management"
              action="action_cn_einvoice_reconciliation_cases" sequence="48"
              groups="sudo_global_finance.group_compliance_user"/>

    <menuitem id="menu_cn_einvoice_reconciliation_start"
              name="发起账票勾稽"
              parent="sudo_global_finance.menu_compliance_management"
              action="action_cn_einvoice_reconciliation_wizard" sequence="49"
              groups="sudo_global_finance.group_compliance_manager"/>

    <menuitem id="menu_cn_einvoice_reconciliation_runs"
              name="账票勾稽批次"
              parent="sudo_global_finance.menu_compliance_management"
              action="action_cn_einvoice_reconciliation_runs" sequence="50"
              groups="sudo_global_finance.group_compliance_manager"/>

    <record id="view_cn_einvoice_document_form_reconciliation"
            model="ir.ui.view">
        <field name="name">sudo.cn.einvoice.document.form.reconciliation</field>
        <field name="model">sudo.cn.einvoice.document</field>
        <field name="inherit_id"
               ref="sudo_country_pack_cn.view_cn_einvoice_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]"
                   position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_reconciliation_cases"
                            type="object" class="oe_stat_button"
                            icon="fa-balance-scale"
                            invisible="reconciliation_case_count == 0">
                        <field name="reconciliation_case_count"
                               widget="statinfo" string="账票勾稽"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
