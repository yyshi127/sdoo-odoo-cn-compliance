<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_report_readiness_search" model="ir.ui.view">
        <field name="name">sudo.compliance.assessment.cn.report.readiness.search</field>
        <field name="model">sudo.compliance.assessment</field>
        <field name="arch" type="xml">
            <search string="中国报告准备度">
                <field name="profile_id"/>
                <field name="company_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <filter name="cn_report_latest_scan" string="最新扫描"
                        domain="[('cn_report_is_latest_assessment', '=', True)]"/>
                <filter name="cn_report_historical_scan" string="历史扫描"
                        domain="[('cn_report_is_latest_assessment', '=', False)]"/>
                <separator/>
                <filter name="cn_assessments" string="中国评估"
                        domain="[('country_id.code', '=', 'CN')]"/>
                <separator/>
                <filter name="completed" string="扫描完成"
                        domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter name="cn_report_needs_review" string="待复核"
                        domain="[('cn_report_readiness_state', '=', 'needs_review')]"/>
                <filter name="cn_report_needs_remediation" string="待整改"
                        domain="[('cn_report_readiness_state', '=', 'needs_remediation')]"/>
                <filter name="cn_report_limited" string="受限"
                        domain="[('cn_report_readiness_state', '=', 'limited')]"/>
                <filter name="cn_report_ready" string="可编制"
                        domain="[('cn_report_readiness_state', '=', 'ready')]"/>
                <filter name="cn_report_issued" string="已签发"
                        domain="[('cn_report_readiness_state', '=', 'issued')]"/>
                <filter name="cn_report_rescan_failed" string="复扫失败"
                        domain="[('cn_report_rescan_state', '=', 'failed')]"/>
                <filter name="cn_report_archive_blocked" string="档案受阻"
                        domain="[('cn_report_filing_archive_state', '=', 'blocked')]"/>
                <separator/>
                <filter name="group_company" string="按公司"
                        context="{'group_by': 'company_id'}"/>
                <filter name="group_period" string="按期间结束月"
                        context="{'group_by': 'period_end:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_report_readiness_list" model="ir.ui.view">
        <field name="name">sudo.compliance.assessment.cn.report.readiness.list</field>
        <field name="model">sudo.compliance.assessment</field>
        <field name="arch" type="xml">
            <list string="中国报告准备度" create="0" delete="0"
                  decoration-danger="cn_report_readiness_state in ('needs_review', 'needs_remediation')"
                  decoration-warning="cn_report_readiness_state in ('needs_scan', 'limited', 'draft_report', 'submitted')"
                  decoration-success="cn_report_readiness_state in ('ready', 'issued')">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="profile_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="state" widget="badge"/>
                <field name="cn_report_readiness_state" widget="badge"
                       decoration-success="cn_report_readiness_state in ('ready', 'issued')"
                       decoration-danger="cn_report_readiness_state in ('needs_review', 'needs_remediation')"
                       decoration-warning="cn_report_readiness_state in ('needs_scan', 'limited', 'draft_report', 'submitted')"/>
                <field name="cn_report_issue_count"/>
                <field name="cn_report_readiness_blocker_summary" optional="show"/>
                <field name="cn_report_action_summary" optional="show"/>
                <field name="cn_report_open_task_count"/>
                <field name="cn_report_limitation_count"/>
                <field name="cn_report_pending_tax_impact_count"/>
                <field name="cn_report_rescan_state" widget="badge"
                       decoration-success="cn_report_rescan_state == 'verified'"
                       decoration-danger="cn_report_rescan_state == 'failed'"
                       decoration-warning="cn_report_rescan_state in ('in_progress', 'pending_rescan', 'evidence_gap')"
                       decoration-muted="cn_report_rescan_state == 'not_applicable'"/>
                <field name="cn_report_pending_rescan_count" optional="show"/>
                <field name="cn_report_failed_rescan_count" optional="show"/>
                <field name="cn_report_verified_remediation_count" optional="show"/>
                <field name="cn_report_rescan_next_action" optional="show"/>
                <field name="cn_report_filing_archive_state" widget="badge"
                       decoration-success="cn_report_filing_archive_state == 'ready'"
                       decoration-warning="cn_report_filing_archive_state in ('attention', 'not_started')"
                       decoration-danger="cn_report_filing_archive_state == 'blocked'"/>
                <field name="cn_report_filing_archive_count" optional="show"/>
                <field name="cn_report_sealed_filing_archive_count" optional="show"/>
                <field name="cn_report_filing_archive_issue_count" optional="show"/>
                <field name="cn_report_filing_archive_next_action" optional="show"/>
                <field name="cn_report_ai_guidance_state" widget="badge"
                       decoration-success="cn_report_ai_guidance_state == 'ready'"
                       decoration-warning="cn_report_ai_guidance_state in ('attention', 'not_started')"
                       decoration-danger="cn_report_ai_guidance_state == 'blocked'"/>
                <field name="cn_report_ai_guidance_finding_count" optional="show"/>
                <field name="cn_report_ai_guidance_generated_count" optional="show"/>
                <field name="cn_report_ai_guidance_current_count" optional="show"/>
                <field name="cn_report_ai_guidance_limited_count" optional="show"/>
                <field name="cn_report_ai_guidance_stale_count" optional="show"/>
                <field name="cn_report_ai_guidance_next_action" optional="show"/>
                <field name="cn_data_basis_state" widget="badge"
                       decoration-success="cn_data_basis_state == 'ready'"
                       decoration-warning="cn_data_basis_state in ('missing', 'warning', 'no_period')"
                       decoration-danger="cn_data_basis_state == 'blocked'"/>
                <field name="cn_data_basis_dataset_count" optional="show"/>
                <field name="cn_data_basis_normalized_record_count" optional="show"/>
                <field name="cn_data_basis_required_type_count" optional="show"/>
                <field name="cn_data_basis_ready_type_count" optional="show"/>
                <field name="cn_data_basis_missing_type_count" optional="show"/>
                <field name="cn_data_basis_missing_type_summary" optional="show"/>
                <field name="cn_data_basis_next_action" optional="show"/>
                <field name="cn_accounting_basis_state" widget="badge" optional="show"
                       decoration-success="cn_accounting_basis_state == 'ready'"
                       decoration-warning="cn_accounting_basis_state == 'warning'"
                       decoration-danger="cn_accounting_basis_state in ('no_period', 'missing')"/>
                <field name="cn_accounting_basis_posted_move_count" optional="show"/>
                <field name="cn_accounting_basis_draft_move_count" optional="show"/>
                <field name="cn_accounting_basis_posted_invoice_count" optional="show"/>
                <field name="cn_accounting_basis_next_action" optional="hide"/>
                <button name="action_cn_open_assessment_accounting_basis" type="object"
                        string="账务" class="btn-link"/>
                <field name="cn_obligation_basis_state" widget="badge"
                       decoration-success="cn_obligation_basis_state == 'ready'"
                       decoration-warning="cn_obligation_basis_state in ('missing', 'attention')"/>
                <field name="cn_obligation_basis_pending_count" optional="show"/>
                <field name="cn_obligation_basis_next_action" optional="show"/>
                <field name="cn_report_next_action"/>
                <field name="cn_report_latest_report_id"/>
            </list>
        </field>
    </record>

    <record id="view_cn_report_readiness_kanban" model="ir.ui.view">
        <field name="name">sudo.compliance.assessment.cn.report.readiness.kanban</field>
        <field name="model">sudo.compliance.assessment</field>
        <field name="arch" type="xml">
            <kanban string="中国报告准备度"
                    class="o_kanban_dashboard o_cn_review_queue_kanban o_cn_report_readiness_kanban"
                    create="0" quick_create="0" sample="0"
                    default_order="period_end desc, id desc">
                <field name="profile_id"/>
                <field name="company_id"/>
                <field name="cn_report_is_latest_assessment"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="state"/>
                <field name="cn_report_readiness_state"/>
                <field name="cn_report_next_action"/>
                <field name="cn_report_action_summary"/>
                <field name="cn_report_readiness_blocker_summary"/>
                <field name="cn_report_issue_count"/>
                <field name="cn_report_open_task_count"/>
                <field name="cn_report_limitation_count"/>
                <field name="cn_report_pending_tax_impact_count"/>
                <field name="cn_report_latest_report_id"/>
                <field name="cn_report_can_prepare"/>
                <field name="cn_report_rescan_state"/>
                <field name="cn_report_rescan_next_action"/>
                <field name="cn_report_pending_rescan_count"/>
                <field name="cn_report_failed_rescan_count"/>
                <field name="cn_report_verified_remediation_count"/>
                <field name="cn_report_filing_archive_state"/>
                <field name="cn_report_filing_archive_next_action"/>
                <field name="cn_report_filing_archive_count"/>
                <field name="cn_report_sealed_filing_archive_count"/>
                <field name="cn_report_filing_archive_issue_count"/>
                <field name="cn_report_ai_guidance_state"/>
                <field name="cn_report_ai_guidance_next_action"/>
                <field name="cn_report_ai_guidance_finding_count"/>
                <field name="cn_report_ai_guidance_generated_count"/>
                <field name="cn_report_ai_guidance_current_count"/>
                <field name="cn_report_ai_guidance_limited_count"/>
                <field name="cn_report_ai_guidance_stale_count"/>
                <field name="cn_data_basis_state"/>
                <field name="cn_data_basis_dataset_count"/>
                <field name="cn_data_basis_ready_count"/>
                <field name="cn_data_basis_warning_count"/>
                <field name="cn_data_basis_blocked_count"/>
                <field name="cn_data_basis_normalized_record_count"/>
                <field name="cn_data_basis_required_type_count"/>
                <field name="cn_data_basis_ready_type_count"/>
                <field name="cn_data_basis_missing_type_count"/>
                <field name="cn_data_basis_missing_type_summary"/>
                <field name="cn_data_basis_next_action"/>
                <field name="cn_accounting_basis_state"/>
                <field name="cn_accounting_basis_posted_move_count"/>
                <field name="cn_accounting_basis_draft_move_count"/>
                <field name="cn_accounting_basis_posted_invoice_count"/>
                <field name="cn_accounting_basis_next_action"/>
                <field name="cn_obligation_basis_state"/>
                <field name="cn_obligation_basis_candidate_count"/>
                <field name="cn_obligation_basis_applicable_count"/>
                <field name="cn_obligation_basis_pending_count"/>
                <field name="cn_obligation_basis_filing_count"/>
                <field name="cn_obligation_basis_next_action"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_cn_report_card oe_kanban_global_click #{record.cn_report_readiness_state.raw_value == 'ready' || record.cn_report_readiness_state.raw_value == 'issued' ? 'is-ready' : record.cn_report_readiness_state.raw_value == 'needs_review' || record.cn_report_readiness_state.raw_value == 'needs_remediation' ? 'is-blocked' : 'is-warning'}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold fs-5">
                                        <field name="company_id"/>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="period_start"/>
                                        <span> 至 </span>
                                        <field name="period_end"/>
                                    </div>
                                </div>
                                <field name="cn_report_readiness_state" widget="badge"
                                       decoration-success="cn_report_readiness_state in ('ready', 'issued')"
                                       decoration-danger="cn_report_readiness_state in ('needs_review', 'needs_remediation')"
                                       decoration-warning="cn_report_readiness_state in ('needs_scan', 'limited', 'draft_report', 'submitted')"/>
                            </div>
                            <div class="o_cn_report_summary">
                                <div>
                                    <div class="o_cn_review_label">现在要做什么</div>
                                    <div class="fw-semibold o_cn_line_clamp_2">
                                        <field name="cn_report_next_action"/>
                                    </div>
                                </div>
                                <div>
                                    <div class="o_cn_review_label">报告阻断事项</div>
                                    <div class="o_cn_line_clamp_2">
                                        <field name="cn_report_readiness_blocker_summary"/>
                                    </div>
                                </div>
                                <div class="o_cn_report_metrics">
                                    <button type="object" name="action_cn_open_report_readiness_findings"
                                            class="o_cn_metric_link">
                                        <span>问题</span>
                                        <strong><field name="cn_report_issue_count"/></strong>
                                    </button>
                                    <button type="object" name="action_cn_open_report_readiness_tasks"
                                            class="o_cn_metric_link">
                                        <span>未关闭整改</span>
                                        <strong><field name="cn_report_open_task_count"/></strong>
                                    </button>
                                    <div class="o_cn_metric_link">
                                        <span>限制项</span>
                                        <strong><field name="cn_report_limitation_count"/></strong>
                                    </div>
                                </div>
                            </div>
                            <div class="o_cn_report_gate_grid">
                                <div class="o_cn_report_gate">
                                    <div class="o_cn_review_label">数据基础</div>
                                    <field name="cn_data_basis_state" widget="badge"
                                           decoration-success="cn_data_basis_state == 'ready'"
                                           decoration-warning="cn_data_basis_state in ('missing', 'warning', 'no_period')"
                                           decoration-danger="cn_data_basis_state == 'blocked'"/>
                                    <div class="small mt-1">
                                        <field name="cn_data_basis_ready_type_count"/>
                                        <span>/</span>
                                        <field name="cn_data_basis_required_type_count"/>
                                        <span> 类就绪</span>
                                    </div>
                                </div>
                                <button type="object" name="action_cn_open_assessment_accounting_basis"
                                        class="o_cn_report_gate">
                                    <div class="o_cn_review_label">账务基础</div>
                                    <field name="cn_accounting_basis_state" widget="badge"
                                           decoration-success="cn_accounting_basis_state == 'ready'"
                                           decoration-warning="cn_accounting_basis_state == 'warning'"
                                           decoration-danger="cn_accounting_basis_state in ('no_period', 'missing')"/>
                                    <div class="small mt-1">
                                        <field name="cn_accounting_basis_posted_move_count"/>
                                        <span> 张已过账凭证</span>
                                    </div>
                                </button>
                                <button type="object" name="action_cn_open_assessment_obligation_basis"
                                        class="o_cn_report_gate">
                                    <div class="o_cn_review_label">纳税义务</div>
                                    <field name="cn_obligation_basis_state" widget="badge"
                                           decoration-success="cn_obligation_basis_state == 'ready'"
                                           decoration-warning="cn_obligation_basis_state in ('missing', 'attention')"/>
                                    <div class="small mt-1">
                                        <field name="cn_obligation_basis_pending_count"/>
                                        <span> 项待确认</span>
                                    </div>
                                </button>
                                <div class="o_cn_report_gate">
                                    <div class="o_cn_review_label">整改复扫</div>
                                    <field name="cn_report_rescan_state" widget="badge"
                                           decoration-success="cn_report_rescan_state == 'verified'"
                                           decoration-danger="cn_report_rescan_state == 'failed'"
                                           decoration-warning="cn_report_rescan_state in ('in_progress', 'pending_rescan', 'evidence_gap')"
                                           decoration-muted="cn_report_rescan_state == 'not_applicable'"/>
                                    <div class="small mt-1">
                                        <field name="cn_report_pending_rescan_count"/>
                                        <span> 待复扫 · </span>
                                        <field name="cn_report_failed_rescan_count"/>
                                        <span> 未通过</span>
                                    </div>
                                </div>
                                <div class="o_cn_report_gate">
                                    <div class="o_cn_review_label">申报缴款档案</div>
                                    <field name="cn_report_filing_archive_state" widget="badge"
                                           decoration-success="cn_report_filing_archive_state == 'ready'"
                                           decoration-warning="cn_report_filing_archive_state in ('attention', 'not_started')"
                                           decoration-danger="cn_report_filing_archive_state == 'blocked'"/>
                                    <div class="small mt-1">
                                        <field name="cn_report_sealed_filing_archive_count"/>
                                        <span>/</span>
                                        <field name="cn_report_filing_archive_count"/>
                                        <span> 已封存</span>
                                    </div>
                                </div>
                                <div class="o_cn_report_gate">
                                    <div class="o_cn_review_label">受控 AI 指引</div>
                                    <field name="cn_report_ai_guidance_state" widget="badge"
                                           decoration-success="cn_report_ai_guidance_state == 'ready'"
                                           decoration-warning="cn_report_ai_guidance_state in ('attention', 'not_started')"
                                           decoration-danger="cn_report_ai_guidance_state == 'blocked'"/>
                                    <div class="small mt-1">
                                        <field name="cn_report_ai_guidance_current_count"/>
                                        <span> 份当前有效</span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_cn_report_footer">
                                <span class="text-muted small"
                                      t-if="record.cn_report_is_latest_assessment.raw_value">
                                    当前最新扫描
                                </span>
                                <div class="d-flex flex-wrap gap-2 ms-auto">
                                    <button name="action_prepare_cn_formal_report" type="object"
                                            class="btn btn-primary btn-sm"
                                            invisible="not cn_report_can_prepare">
                                        编制正式报告
                                    </button>
                                    <button name="action_open_cn_formal_reports" type="object"
                                            class="btn btn-outline-secondary btn-sm"
                                            invisible="not cn_report_latest_report_id">
                                        查看正式报告
                                    </button>
                                    <button type="open" class="btn btn-outline-primary btn-sm">
                                        查看准备度详情
                                    </button>
                                </div>
                            </div>
                            <div class="o_cn_report_legacy_detail" t-if="False">
                            <div class="mt-3 text-muted">
                                <field name="cn_report_next_action"/>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="text-muted small">行动摘要</div>
                                <div class="fw-semibold">
                                    <field name="cn_report_action_summary"/>
                                </div>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="text-muted small">报告阻断事项</div>
                                <div class="fw-semibold">
                                    <field name="cn_report_readiness_blocker_summary"/>
                                </div>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted small">整改复扫门禁</div>
                                        <div class="fw-semibold"><field name="cn_report_rescan_next_action"/></div>
                                    </div>
                                    <field name="cn_report_rescan_state" widget="badge"
                                           decoration-success="cn_report_rescan_state == 'verified'"
                                           decoration-danger="cn_report_rescan_state == 'failed'"
                                           decoration-warning="cn_report_rescan_state in ('in_progress', 'pending_rescan', 'evidence_gap')"
                                           decoration-muted="cn_report_rescan_state == 'not_applicable'"/>
                                </div>
                                <div class="d-flex gap-3 text-muted small mt-2">
                                    <span><field name="cn_report_pending_rescan_count"/> 待复扫</span>
                                    <span><field name="cn_report_failed_rescan_count"/> 未通过</span>
                                    <span><field name="cn_report_verified_remediation_count"/> 已验证</span>
                                </div>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted small">申报缴款档案门禁</div>
                                        <div class="fw-semibold"><field name="cn_report_filing_archive_next_action"/></div>
                                    </div>
                                    <field name="cn_report_filing_archive_state" widget="badge"
                                           decoration-success="cn_report_filing_archive_state == 'ready'"
                                           decoration-warning="cn_report_filing_archive_state in ('attention', 'not_started')"
                                           decoration-danger="cn_report_filing_archive_state == 'blocked'"/>
                                </div>
                                <div class="d-flex gap-3 text-muted small mt-2">
                                    <span><field name="cn_report_sealed_filing_archive_count"/> 已封存</span>
                                    <span><field name="cn_report_filing_archive_count"/> 合计</span>
                                    <span><field name="cn_report_filing_archive_issue_count"/> 问题</span>
                                </div>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted small">受控 AI 指引门禁</div>
                                        <div class="fw-semibold"><field name="cn_report_ai_guidance_next_action"/></div>
                                    </div>
                                    <field name="cn_report_ai_guidance_state" widget="badge"
                                           decoration-success="cn_report_ai_guidance_state == 'ready'"
                                           decoration-warning="cn_report_ai_guidance_state in ('attention', 'not_started')"
                                           decoration-danger="cn_report_ai_guidance_state == 'blocked'"/>
                                </div>
                                <div class="d-flex gap-3 text-muted small mt-2">
                                    <span><field name="cn_report_ai_guidance_current_count"/> 当前有效</span>
                                    <span><field name="cn_report_ai_guidance_generated_count"/> 已生成</span>
                                    <span><field name="cn_report_ai_guidance_finding_count"/> 风险</span>
                                    <span><field name="cn_report_ai_guidance_stale_count"/> 已过期</span>
                                </div>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted small">数据基础</div>
                                        <div class="fw-semibold"><field name="cn_data_basis_next_action"/></div>
                                    </div>
                                    <field name="cn_data_basis_state" widget="badge"
                                           decoration-success="cn_data_basis_state == 'ready'"
                                           decoration-warning="cn_data_basis_state in ('missing', 'warning', 'no_period')"
                                           decoration-danger="cn_data_basis_state == 'blocked'"/>
                                </div>
                                <div class="d-flex gap-3 text-muted small mt-2">
                                    <span><field name="cn_data_basis_ready_type_count"/> 已就绪类型</span>
                                    <span><field name="cn_data_basis_required_type_count"/> 必需类型</span>
                                    <span><field name="cn_data_basis_missing_type_count"/> 缺失</span>
                                </div>
                                <div class="text-muted small mt-1"
                                     invisible="not cn_data_basis_missing_type_summary">
                                    缺失：<field name="cn_data_basis_missing_type_summary"/>
                                </div>
                            </div>
                            <button type="object" name="action_cn_open_assessment_accounting_basis"
                                    class="btn btn-light w-100 text-start border mt-3">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted small">Odoo 账务基础</div>
                                        <div class="fw-semibold"><field name="cn_accounting_basis_next_action"/></div>
                                    </div>
                                    <field name="cn_accounting_basis_state" widget="badge"
                                           decoration-success="cn_accounting_basis_state == 'ready'"
                                           decoration-warning="cn_accounting_basis_state == 'warning'"
                                           decoration-danger="cn_accounting_basis_state in ('no_period', 'missing')"/>
                                </div>
                                <div class="d-flex gap-3 text-muted small mt-2">
                                    <span><field name="cn_accounting_basis_posted_move_count"/> 已过账凭证</span>
                                    <span><field name="cn_accounting_basis_draft_move_count"/> 草稿凭证</span>
                                    <span><field name="cn_accounting_basis_posted_invoice_count"/> 已过账发票</span>
                                </div>
                            </button>
                            <div class="mt-3 border rounded p-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted small">纳税义务基础</div>
                                        <div class="fw-semibold"><field name="cn_obligation_basis_next_action"/></div>
                                    </div>
                                    <field name="cn_obligation_basis_state" widget="badge"
                                           decoration-success="cn_obligation_basis_state == 'ready'"
                                           decoration-warning="cn_obligation_basis_state in ('missing', 'attention')"/>
                                </div>
                            </div>
                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_report_readiness_findings"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">准备度问题</div>
                                        <div class="fw-bold"><field name="cn_report_issue_count"/></div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_report_readiness_tasks"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">未关闭整改</div>
                                        <div class="fw-bold"><field name="cn_report_open_task_count"/></div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">限制项</div>
                                        <div class="fw-bold"><field name="cn_report_limitation_count"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">待量化影响</div>
                                        <div class="fw-bold"><field name="cn_report_pending_tax_impact_count"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_assessment_data_basis"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">相关数据集</div>
                                        <div class="fw-bold"><field name="cn_data_basis_dataset_count"/></div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">规范化记录</div>
                                        <div class="fw-bold"><field name="cn_data_basis_normalized_record_count"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_assessment_obligation_basis"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">候选义务</div>
                                        <div class="fw-bold"><field name="cn_obligation_basis_candidate_count"/></div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">待确认义务</div>
                                        <div class="fw-bold"><field name="cn_obligation_basis_pending_count"/></div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button name="action_prepare_cn_formal_report" type="object"
                                        class="btn btn-primary btn-sm"
                                        invisible="not cn_report_can_prepare">
                                    编制正式报告
                                </button>
                                <button name="action_open_cn_formal_reports" type="object"
                                        class="btn btn-outline-secondary btn-sm"
                                        invisible="not cn_report_latest_report_id">
                                    查看正式报告
                                </button>
                            </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_compliance_assessment_cn_report_readiness_form" model="ir.ui.view">
        <field name="name">sudo.compliance.assessment.cn.report.readiness.form</field>
        <field name="model">sudo.compliance.assessment</field>
        <field name="inherit_id" ref="sudo_global_finance.view_compliance_assessment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_prepare_cn_formal_report" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="country_id.code != 'CN' or not cn_report_can_prepare">
                    <field name="cn_report_readiness_state" widget="statinfo"
                           string="报告准备度"/>
                </button>
                <button name="action_cn_open_assessment_data_basis" type="object"
                        class="oe_stat_button" icon="fa-database"
                        invisible="country_id.code != 'CN'">
                    <field name="cn_data_basis_dataset_count" widget="statinfo"
                           string="数据来源"/>
                </button>
                <button name="action_cn_open_assessment_obligation_basis" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        invisible="country_id.code != 'CN'">
                    <field name="cn_obligation_basis_pending_count" widget="statinfo"
                           string="义务"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group string="中国报告准备度" col="4"
                       invisible="country_id.code != 'CN'">
                    <group>
                        <field name="cn_report_readiness_state" widget="badge"
                               decoration-success="cn_report_readiness_state in ('ready', 'issued')"
                               decoration-danger="cn_report_readiness_state in ('needs_review', 'needs_remediation')"
                               decoration-warning="cn_report_readiness_state in ('needs_scan', 'limited', 'draft_report', 'submitted')"/>
                        <field name="cn_report_next_action"/>
                        <field name="cn_report_action_summary"/>
                        <field name="cn_report_readiness_blocker_summary"/>
                        <field name="cn_report_latest_report_id"/>
                    </group>
                    <group>
                        <field name="cn_report_issue_count"/>
                        <field name="cn_report_open_task_count"/>
                        <field name="cn_report_limitation_count"/>
                        <field name="cn_report_pending_tax_impact_count"/>
                        <field name="cn_report_rescan_state" widget="badge"
                               decoration-success="cn_report_rescan_state == 'verified'"
                               decoration-danger="cn_report_rescan_state == 'failed'"
                               decoration-warning="cn_report_rescan_state in ('in_progress', 'pending_rescan', 'evidence_gap')"
                               decoration-muted="cn_report_rescan_state == 'not_applicable'"/>
                        <field name="cn_report_rescan_next_action"/>
                        <field name="cn_report_pending_rescan_count"/>
                        <field name="cn_report_failed_rescan_count"/>
                        <field name="cn_report_verified_remediation_count"/>
                        <field name="cn_report_filing_archive_state" widget="badge"
                               decoration-success="cn_report_filing_archive_state == 'ready'"
                               decoration-warning="cn_report_filing_archive_state in ('attention', 'not_started')"
                               decoration-danger="cn_report_filing_archive_state == 'blocked'"/>
                        <field name="cn_report_filing_archive_next_action"/>
                        <field name="cn_report_filing_archive_count"/>
                        <field name="cn_report_sealed_filing_archive_count"/>
                        <field name="cn_report_filing_archive_issue_count"/>
                        <field name="cn_report_ai_guidance_state" widget="badge"
                               decoration-success="cn_report_ai_guidance_state == 'ready'"
                               decoration-warning="cn_report_ai_guidance_state in ('attention', 'not_started')"
                               decoration-danger="cn_report_ai_guidance_state == 'blocked'"/>
                        <field name="cn_report_ai_guidance_next_action"/>
                        <field name="cn_report_ai_guidance_finding_count"/>
                        <field name="cn_report_ai_guidance_generated_count"/>
                        <field name="cn_report_ai_guidance_current_count"/>
                        <field name="cn_report_ai_guidance_limited_count"/>
                        <field name="cn_report_ai_guidance_stale_count"/>
                        <field name="cn_data_basis_state" widget="badge"
                               decoration-success="cn_data_basis_state == 'ready'"
                               decoration-warning="cn_data_basis_state in ('missing', 'warning', 'no_period')"
                               decoration-danger="cn_data_basis_state == 'blocked'"/>
                        <field name="cn_data_basis_dataset_count"/>
                        <field name="cn_data_basis_ready_count"/>
                        <field name="cn_data_basis_warning_count"/>
                        <field name="cn_data_basis_blocked_count"/>
                        <field name="cn_data_basis_normalized_record_count"/>
                        <field name="cn_data_basis_required_type_count"/>
                        <field name="cn_data_basis_ready_type_count"/>
                        <field name="cn_data_basis_missing_type_count"/>
                        <field name="cn_data_basis_missing_type_summary"/>
                        <field name="cn_data_basis_next_action"/>
                        <field name="cn_obligation_basis_state" widget="badge"
                               decoration-success="cn_obligation_basis_state == 'ready'"
                               decoration-warning="cn_obligation_basis_state in ('missing', 'attention')"/>
                        <field name="cn_obligation_basis_candidate_count"/>
                        <field name="cn_obligation_basis_applicable_count"/>
                        <field name="cn_obligation_basis_pending_count"/>
                        <field name="cn_obligation_basis_filing_count"/>
                        <field name="cn_obligation_basis_next_action"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_cn_report_readiness" model="ir.actions.act_window">
        <field name="name">中国报告准备度</field>
        <field name="res_model">sudo.compliance.assessment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_cn_report_readiness_search"/>
        <field name="domain">[('country_id.code', '=', 'CN')]</field>
        <field name="context">{'search_default_cn_report_latest_scan': 1, 'search_default_cn_assessments': 1, 'search_default_completed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有中国合规评估</p>
            <p>完成规则扫描后，可以在这里判断是否具备正式报告编制条件。</p>
        </field>
    </record>

    <record id="action_cn_report_readiness_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_cn_report_readiness_kanban"/>
        <field name="act_window_id" ref="action_cn_report_readiness"/>
    </record>

    <record id="action_cn_report_readiness_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_cn_report_readiness_list"/>
        <field name="act_window_id" ref="action_cn_report_readiness"/>
    </record>

    <record id="action_cn_report_readiness_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sudo_global_finance.view_compliance_assessment_form"/>
        <field name="act_window_id" ref="action_cn_report_readiness"/>
    </record>

    <menuitem id="menu_cn_report_readiness"
              name="中国报告准备度"
              parent="sudo_global_finance.menu_global_finance_root"
              action="action_cn_report_readiness"
              sequence="25"
              groups="sudo_global_finance.group_compliance_user"/>
</odoo>
