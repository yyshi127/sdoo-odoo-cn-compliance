<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_cross_border_transaction_search" model="ir.ui.view">
        <field name="name">sudo.cn.cross.border.transaction.search</field>
        <field name="model">sudo.cn.cross.border.transaction</field>
        <field name="arch" type="xml">
            <search string="Cross-Border Transactions">
                <field name="name"/>
                <field name="company_id"/>
                <field name="profile_id"/>
                <field name="counterparty_name"/>
                <field name="counterparty_country_id"/>
                <field name="transaction_type"/>
                <filter name="needs_review" string="Needs Review"
                        domain="[('state', 'in', ('draft', 'submitted'))]"/>
                <filter name="reviewed" string="Reviewed"
                        domain="[('state', '=', 'reviewed')]"/>
                <filter name="related_party" string="Related Party"
                        domain="[('related_party', '=', True)]"/>
                <filter name="withholding_not_considered" string="Withholding Not Considered"
                        domain="[('withholding_considered', '=', False)]"/>
                <separator/>
                <filter name="group_state" string="By State"
                        context="{'group_by': 'state'}"/>
                <filter name="group_type" string="By Type"
                        context="{'group_by': 'transaction_type'}"/>
                <filter name="group_country" string="By Counterparty Country"
                        context="{'group_by': 'counterparty_country_id'}"/>
                <filter name="group_company" string="By Company"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_cross_border_transaction_list" model="ir.ui.view">
        <field name="name">sudo.cn.cross.border.transaction.list</field>
        <field name="model">sudo.cn.cross.border.transaction</field>
        <field name="arch" type="xml">
            <list string="Cross-Border Transactions"
                  decoration-success="state == 'reviewed'"
                  decoration-warning="state in ('draft', 'submitted')"
                  decoration-muted="state == 'cancelled'">
                <field name="transaction_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="transaction_type" widget="badge"/>
                <field name="counterparty_name"/>
                <field name="counterparty_country_id"/>
                <field name="related_party"/>
                <field name="amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="withholding_considered"/>
                <field name="cn_cross_border_readiness_state" widget="badge"
                       decoration-success="cn_cross_border_readiness_state == 'reviewed'"
                       decoration-warning="cn_cross_border_readiness_state in ('draft', 'needs_evidence', 'needs_review')"
                       decoration-muted="cn_cross_border_readiness_state == 'cancelled'"/>
                <field name="cn_cross_border_next_action" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="reviewer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="reviewed_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_cn_cross_border_transaction_kanban" model="ir.ui.view">
        <field name="name">sudo.cn.cross.border.transaction.kanban</field>
        <field name="model">sudo.cn.cross.border.transaction</field>
        <field name="arch" type="xml">
            <kanban string="Cross-Border Transactions" class="o_kanban_dashboard"
                    quick_create="0" sample="0" default_group_by="state">
                <field name="name"/>
                <field name="company_id"/>
                <field name="transaction_date"/>
                <field name="transaction_type"/>
                <field name="counterparty_name"/>
                <field name="counterparty_country_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="related_party"/>
                <field name="withholding_considered"/>
                <field name="cn_cross_border_readiness_state"/>
                <field name="cn_cross_border_next_action"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click shadow-sm border-start border-4 #{record.state.raw_value == 'reviewed' ? 'border-success' : record.state.raw_value == 'cancelled' ? 'border-secondary' : 'border-warning'}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold"><field name="counterparty_name"/></div>
                                    <div class="text-muted small">
                                        <field name="transaction_date"/>
                                        <span> / </span>
                                        <field name="counterparty_country_id"/>
                                    </div>
                                </div>
                                <field name="cn_cross_border_readiness_state" widget="badge"/>
                            </div>
                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">Type</div>
                                        <field name="transaction_type" widget="badge"/>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">Amount</div>
                                        <div class="fw-bold"><field name="amount"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">Related Party</div>
                                        <field name="related_party"/>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 h-100">
                                        <div class="text-muted small">Withholding</div>
                                        <field name="withholding_considered"/>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 border rounded p-2">
                                <div class="text-muted small">Next Action</div>
                                <div class="fw-semibold"><field name="cn_cross_border_next_action"/></div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button name="action_submit" type="object"
                                        class="btn btn-primary btn-sm"
                                        invisible="state != 'draft'">
                                    Submit
                                </button>
                                <button name="action_mark_reviewed" type="object"
                                        class="btn btn-success btn-sm"
                                        invisible="state != 'submitted'">
                                    Mark Reviewed
                                </button>
                                <button name="action_cancel" type="object"
                                        class="btn btn-outline-secondary btn-sm"
                                        invisible="state in ('reviewed', 'cancelled')">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cn_cross_border_transaction_form" model="ir.ui.view">
        <field name="name">sudo.cn.cross.border.transaction.form</field>
        <field name="model">sudo.cn.cross.border.transaction</field>
        <field name="arch" type="xml">
            <form string="Cross-Border Transaction">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_reviewed" type="object"
                            string="Mark Reviewed" class="btn-primary"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="state in ('reviewed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,reviewed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        This record captures controlled cross-border facts only. It does not conclude withholding tax, treaty relief, transfer pricing, customs, VAT or foreign exchange compliance.
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="profile_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="period_start" readonly="state != 'draft'"/>
                            <field name="period_end" readonly="state != 'draft'"/>
                            <field name="transaction_date" readonly="state != 'draft'"/>
                            <field name="transaction_type" readonly="state != 'draft'"/>
                        </group>
                        <group string="Counterparty">
                            <field name="counterparty_name" readonly="state != 'draft'"/>
                            <field name="counterparty_country_id" readonly="state != 'draft'"/>
                            <field name="related_party" readonly="state != 'draft'"/>
                            <field name="service_or_asset_location" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Amount and References">
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="contract_reference" readonly="state != 'draft'"/>
                            <field name="payment_reference" readonly="state != 'draft'"/>
                        </group>
                        <group string="Review">
                            <field name="withholding_considered" readonly="state != 'draft'"/>
                            <field name="cn_cross_border_readiness_state" widget="badge" readonly="1"/>
                            <field name="cn_cross_border_next_action" readonly="1"/>
                            <field name="reviewer_id" readonly="1" widget="many2one_avatar_user"/>
                            <field name="reviewed_at" readonly="1"/>
                            <field name="snapshot_checksum" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes and Limitations">
                            <group string="Withholding Review Note">
                                <field name="withholding_note" nolabel="1"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group string="Limitations">
                                <field name="limitation_note" nolabel="1"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group string="Review Notes">
                                <field name="review_notes" nolabel="1"
                                       readonly="state == 'reviewed'"/>
                            </group>
                        </page>
                        <page name="evidence" string="Evidence">
                            <field name="evidence_attachment_ids"
                                   widget="many2many_binary"
                                   readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cn_cross_border_transactions" model="ir.actions.act_window">
        <field name="name">Cross-Border Transactions</field>
        <field name="res_model">sudo.cn.cross.border.transaction</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_cn_cross_border_transaction_search"/>
        <field name="context">{'search_default_needs_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No controlled cross-border transactions yet</p>
            <p>Register contracts, payments, royalties, service fees and other cross-border facts before using them in compliance scans or report limitations.</p>
        </field>
    </record>

    <menuitem id="menu_cn_cross_border_transactions"
              name="Cross-Border"
              parent="sudo_global_finance.menu_global_finance_root"
              action="action_cn_cross_border_transactions"
              sequence="33"
              groups="sudo_global_finance.group_compliance_user"/>
</odoo>
