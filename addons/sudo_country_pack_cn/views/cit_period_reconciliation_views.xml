<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_cit_period_reconciliation_run_search" model="ir.ui.view">
        <field name="name">sudo.cn.cit.period.reconciliation.run.search</field>
        <field name="model">sudo.cn.cit.period.reconciliation.run</field>
        <field name="arch" type="xml">
            <search string="企业所得税账税勾稽">
                <field name="profile_id"/>
                <field name="company_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="return_period_type"/>
                <filter name="current" string="当前成功结果"
                        domain="[('state', '=', 'succeeded')]"/>
                <filter name="insufficient" string="数据不足"
                        domain="[('conclusion_state', '=', 'insufficient_data')]"/>
                <filter name="differences" string="存在差异"
                        domain="[('conclusion_state', '=', 'differences')]"/>
                <filter name="aligned" string="算术一致"
                        domain="[('conclusion_state', '=', 'aligned')]"/>
                <filter name="failed" string="失败"
                        domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="group_company" string="公司"
                        context="{'group_by': 'company_id'}"/>
                <filter name="group_period_type" string="申报期间类型"
                        context="{'group_by': 'return_period_type'}"/>
                <filter name="group_conclusion" string="勾稽结论"
                        context="{'group_by': 'conclusion_state'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_cit_period_reconciliation_run_list" model="ir.ui.view">
        <field name="name">sudo.cn.cit.period.reconciliation.run.list</field>
        <field name="model">sudo.cn.cit.period.reconciliation.run</field>
        <field name="arch" type="xml">
            <list string="企业所得税账税勾稽" create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed' or conclusion_state == 'insufficient_data'"
                  decoration-warning="state in ('queued', 'processing') or conclusion_state == 'differences' or (conclusion_state == 'aligned' and warning_issue_count &gt; 0)"
                  decoration-success="conclusion_state == 'aligned' and warning_issue_count == 0"
                  decoration-muted="state in ('cancelled', 'superseded')">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="return_period_type" widget="badge"/>
                <field name="accounting_source_state" widget="badge"/>
                <field name="filing_source_state" widget="badge"/>
                <field name="payment_source_state" widget="badge"/>
                <field name="ledger_accounting_profit_amount" sum="账簿利润"/>
                <field name="filing_taxable_income_amount" sum="应纳税所得额"/>
                <field name="blocking_issue_count" sum="阻断"/>
                <field name="difference_issue_count" sum="差异"/>
                <field name="warning_issue_count" sum="提示" optional="show"/>
                <field name="conclusion_state" widget="badge"
                       decoration-danger="conclusion_state == 'insufficient_data'"
                       decoration-warning="conclusion_state == 'differences'"
                       decoration-success="conclusion_state == 'aligned'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'queued'"
                       decoration-warning="state == 'processing'"
                       decoration-success="state == 'succeeded'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state in ('cancelled', 'superseded')"/>
            </list>
        </field>
    </record>

    <record id="view_cn_cit_period_reconciliation_run_form" model="ir.ui.view">
        <field name="name">sudo.cn.cit.period.reconciliation.run.form</field>
        <field name="model">sudo.cn.cit.period.reconciliation.run</field>
        <field name="arch" type="xml">
            <form string="企业所得税账税勾稽" create="0" edit="0" delete="0">
                <header>
                    <button name="action_queue_compliance_assessment"
                            type="object" string="发起规则扫描"
                            class="btn-primary"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="state != 'succeeded'"/>
                    <button name="action_cancel" type="object" string="取消批次"
                            class="btn-secondary"
                            groups="sudo_global_finance.group_compliance_manager"
                            invisible="state != 'queued'"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="queued,processing,succeeded,failed,cancelled,superseded"/>
                </header>
                <sheet>
                    <field name="has_filing_accounting_profit_amount" invisible="1"/>
                    <field name="has_filing_adjustment_increase_amount" invisible="1"/>
                    <field name="has_filing_adjustment_decrease_amount" invisible="1"/>
                    <field name="has_filing_taxable_income_amount" invisible="1"/>
                    <field name="has_expected_taxable_income_amount" invisible="1"/>
                    <field name="has_filing_tax_payable_amount" invisible="1"/>
                    <field name="has_filing_tax_relief_amount" invisible="1"/>
                    <field name="has_filing_tax_credit_amount" invisible="1"/>
                    <field name="has_filing_prepaid_tax_amount" invisible="1"/>
                    <field name="has_filing_payable_amount" invisible="1"/>
                    <field name="has_filing_refundable_amount" invisible="1"/>
                    <field name="has_payment_amount" invisible="1"/>
                    <field name="has_refund_amount" invisible="1"/>
                    <field name="has_ledger_filing_profit_difference" invisible="1"/>
                    <field name="has_filing_taxable_arithmetic_difference" invisible="1"/>
                    <field name="has_payable_payment_difference" invisible="1"/>
                    <field name="has_refundable_refund_difference" invisible="1"/>
                    <widget name="web_ribbon" title="已被新结果替代"
                            bg_color="text-bg-secondary"
                            invisible="state != 'superseded'"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'failed'">
                        本次运行失败且没有替代上一份成功结果，请根据失败代码检查输入或配置。
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="result_integrity_state != 'checksum_mismatch'">
                        <strong>结果完整性异常。</strong>
                        汇总金额、问题内容或审计指纹与执行时点 SHA-256 不一致，不能用于规则评估或报告。
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'succeeded' or conclusion_state != 'insufficient_data'">
                        <strong>数据不足，不能形成账税金额结论。</strong>
                        系统没有把缺少会计口径、申报、缴退税或来源控制解释为通过。
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'succeeded' or conclusion_state != 'differences'">
                        <strong>存在待复核金额差异。</strong>
                        差异不自动等同于少缴、多缴、违法、税务机关认定或可确认税务影响。
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'succeeded' or conclusion_state != 'aligned' or warning_issue_count != 0">
                        <strong>当前受控口径算术一致。</strong>
                        该结果不证明纳税调整、税率、优惠、扣除、亏损弥补或申报处理合法。
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'succeeded' or conclusion_state != 'aligned' or warning_issue_count == 0">
                        <strong>金额算术一致，但仍有需要复核的来源或结账限制。</strong>
                        请处理下方提示后再进入规则评估和正式报告。
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state not in ('succeeded', 'superseded')">
                        本页保存执行时点快照；后续账务、申报或缴退税变化不会改写本结果，请重新发起勾稽。
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_issues" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="issue_count == 0">
                            <field name="issue_count" widget="statinfo" string="勾稽问题"/>
                        </button>
                        <button name="action_open_accounting_scope" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="not accounting_scope_id">
                            <field name="accounting_scope_line_count" widget="statinfo"
                                   string="口径科目"/>
                        </button>
                        <button name="action_open_filing_record" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not filing_record_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">来源申报</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="勾稽范围">
                            <field name="profile_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="return_period_type" widget="badge"/>
                            <field name="cit_tax_type_code"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="结论与问题">
                            <field name="conclusion_state" widget="badge"
                                   decoration-danger="conclusion_state == 'insufficient_data'"
                                   decoration-warning="conclusion_state == 'differences'"
                                   decoration-success="conclusion_state == 'aligned'"/>
                            <field name="blocking_issue_count"/>
                            <field name="difference_issue_count"/>
                            <field name="warning_issue_count"/>
                            <field name="engine_version"/>
                        </group>
                    </group>
                    <group string="三类来源状态" col="3">
                        <group string="Odoo 账簿">
                            <field name="accounting_source_state" widget="badge"/>
                            <field name="accounting_scope_id"/>
                            <field name="accounting_scope_line_count"/>
                            <field name="posted_accounting_line_count"/>
                            <field name="draft_accounting_line_count"/>
                        </group>
                        <group string="企业所得税申报">
                            <field name="filing_source_state" widget="badge"/>
                            <field name="filing_record_id"/>
                        </group>
                        <group string="缴款与退库">
                            <field name="payment_source_state" widget="badge"/>
                            <field name="payment_dataset_id"/>
                            <field name="payment_record_count"/>
                        </group>
                    </group>
                    <group string="账税利润链" col="3">
                        <group string="Odoo 已过账损益">
                            <field name="ledger_profit_increase_amount"/>
                            <field name="ledger_profit_decrease_amount"/>
                            <field name="ledger_accounting_profit_amount"/>
                        </group>
                        <group string="来源申报账税调整">
                            <field name="filing_accounting_profit_amount"
                                   invisible="not has_filing_accounting_profit_amount"/>
                            <field name="filing_adjustment_increase_amount"
                                   invisible="not has_filing_adjustment_increase_amount"/>
                            <field name="filing_adjustment_decrease_amount"
                                   invisible="not has_filing_adjustment_decrease_amount"/>
                            <field name="filing_taxable_income_amount"
                                   invisible="not has_filing_taxable_income_amount"/>
                            <field name="expected_taxable_income_amount"
                                   invisible="not has_expected_taxable_income_amount"/>
                        </group>
                        <group string="利润链差异">
                            <field name="ledger_filing_profit_difference"
                                   invisible="not has_ledger_filing_profit_difference"/>
                            <field name="filing_taxable_arithmetic_difference"
                                   invisible="not has_filing_taxable_arithmetic_difference"/>
                        </group>
                    </group>
                    <group string="来源税额、缴款与退库" col="3">
                        <group string="来源申报税额">
                            <field name="filing_tax_payable_amount"
                                   invisible="not has_filing_tax_payable_amount"/>
                            <field name="filing_tax_relief_amount"
                                   invisible="not has_filing_tax_relief_amount"/>
                            <field name="filing_tax_credit_amount"
                                   invisible="not has_filing_tax_credit_amount"/>
                            <field name="filing_prepaid_tax_amount"
                                   invisible="not has_filing_prepaid_tax_amount"/>
                            <field name="filing_payable_amount"
                                   invisible="not has_filing_payable_amount"/>
                            <field name="filing_refundable_amount"
                                   invisible="not has_filing_refundable_amount"/>
                        </group>
                        <group string="缴款与退库事实">
                            <field name="paid_principal_amount"
                                   invisible="not has_payment_amount"/>
                            <field name="reversed_principal_amount"
                                   invisible="not has_payment_amount"/>
                            <field name="effective_paid_principal_amount"
                                   invisible="not has_payment_amount"/>
                            <field name="refunded_principal_amount"
                                   invisible="not has_refund_amount"/>
                            <field name="interest_amount"/>
                            <field name="penalty_amount"/>
                        </group>
                        <group string="补退与资金差异">
                            <field name="payable_payment_difference"
                                   invisible="not has_payable_payment_difference"/>
                            <field name="refundable_refund_difference"
                                   invisible="not has_refundable_refund_difference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="勾稽问题">
                            <field name="issue_ids">
                                <list create="0" edit="0" delete="0"
                                      decoration-danger="severity == 'blocking'"
                                      decoration-warning="severity == 'review'"
                                      decoration-info="severity == 'info'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="issue_kind" widget="badge"/>
                                    <field name="source_area" widget="badge"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="difference_amount"
                                           invisible="not has_difference"/>
                                    <field name="affected_record_count" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="来源记录">
                            <field name="payment_record_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="payment_date"/>
                                    <field name="tax_type_code"/>
                                    <field name="payment_status" widget="badge"/>
                                    <field name="principal_amount"/>
                                    <field name="interest_amount" optional="hide"/>
                                    <field name="penalty_amount" optional="hide"/>
                                    <field name="payment_reference"/>
                                    <field name="quality_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="审计指纹">
                            <group>
                                <group>
                                    <field name="accounting_scope_snapshot_checksum"
                                           widget="CopyClipboardChar"/>
                                    <field name="accounting_snapshot_checksum"
                                           widget="CopyClipboardChar"/>
                                    <field name="filing_snapshot_checksum"
                                           widget="CopyClipboardChar"/>
                                </group>
                                <group>
                                    <field name="payment_snapshot_checksum"
                                           widget="CopyClipboardChar"/>
                                    <field name="result_checksum"
                                           widget="CopyClipboardChar"/>
                                    <field name="result_integrity_state" widget="badge"
                                           decoration-success="result_integrity_state == 'verified'"
                                           decoration-muted="result_integrity_state == 'not_available'"
                                           decoration-danger="result_integrity_state == 'checksum_mismatch'"/>
                                    <field name="requested_by_id"/>
                                    <field name="requested_at"/>
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                </group>
                            </group>
                            <group>
                                <field name="result_summary"/>
                                <field name="error_code" invisible="not error_code"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cn_cit_period_reconciliation_issue_search" model="ir.ui.view">
        <field name="name">sudo.cn.cit.period.reconciliation.issue.search</field>
        <field name="model">sudo.cn.cit.period.reconciliation.issue</field>
        <field name="arch" type="xml">
            <search string="企业所得税勾稽问题">
                <field name="name"/>
                <field name="code"/>
                <field name="run_id"/>
                <filter name="current" string="当前成功结果"
                        domain="[('is_current_result', '=', True)]"/>
                <filter name="blocking" string="阻断"
                        domain="[('severity', '=', 'blocking')]"/>
                <filter name="difference" string="金额差异"
                        domain="[('issue_kind', '=', 'difference')]"/>
                <filter name="review" string="需要复核"
                        domain="[('severity', '=', 'review')]"/>
                <separator/>
                <filter name="group_source" string="问题来源"
                        context="{'group_by': 'source_area'}"/>
                <filter name="group_severity" string="严重级别"
                        context="{'group_by': 'severity'}"/>
                <filter name="group_run" string="勾稽批次"
                        context="{'group_by': 'run_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_cit_period_reconciliation_issue_list" model="ir.ui.view">
        <field name="name">sudo.cn.cit.period.reconciliation.issue.list</field>
        <field name="model">sudo.cn.cit.period.reconciliation.issue</field>
        <field name="arch" type="xml">
            <list string="企业所得税勾稽问题" create="0" edit="0" delete="0"
                  decoration-danger="severity == 'blocking'"
                  decoration-warning="severity == 'review'"
                  decoration-info="severity == 'info'"
                  decoration-muted="not is_current_result">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="severity" widget="badge"/>
                <field name="issue_kind" widget="badge"/>
                <field name="source_area" widget="badge"/>
                <field name="code"/>
                <field name="name"/>
                <field name="left_amount" optional="hide"/>
                <field name="right_amount" optional="hide"/>
                <field name="difference_amount" sum="差异金额"
                       invisible="not has_difference"/>
                <field name="affected_record_count" optional="hide"/>
                <field name="run_id"/>
                <field name="is_current_result" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_cn_cit_period_reconciliation_issue_form" model="ir.ui.view">
        <field name="name">sudo.cn.cit.period.reconciliation.issue.form</field>
        <field name="model">sudo.cn.cit.period.reconciliation.issue</field>
        <field name="arch" type="xml">
            <form string="企业所得税勾稽问题" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="分类">
                            <field name="severity" widget="badge"/>
                            <field name="issue_kind" widget="badge"/>
                            <field name="source_area" widget="badge"/>
                            <field name="code"/>
                            <field name="affected_record_count"/>
                        </group>
                        <group string="来源">
                            <field name="run_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_current_result"/>
                        </group>
                    </group>
                    <group string="金额口径" invisible="not has_difference">
                        <group>
                            <field name="left_label"/>
                            <field name="left_amount"/>
                        </group>
                        <group>
                            <field name="right_label"/>
                            <field name="right_amount"/>
                            <field name="difference_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="action_hint"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cn_cit_period_reconciliation_wizard_form" model="ir.ui.view">
        <field name="name">sudo.cn.cit.period.reconciliation.wizard.form</field>
        <field name="model">sudo.cn.cit.period.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="发起企业所得税账税勾稽">
                <div class="alert alert-info" role="alert">
                    系统将比较已核验 Odoo 损益口径、唯一当前来源申报以及完整缴退税数据。请输入来源数据实际使用的所得税代码；系统不会自动猜测税种编码。
                </div>
                <group>
                    <field name="profile_id" options="{'no_create': True}"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="return_period_type"/>
                    <field name="cit_tax_type_code" placeholder="例如来源数据中的实际 tax_type_code"/>
                </group>
                <footer>
                    <button name="action_queue" type="object"
                            string="提交后台勾稽" class="btn-primary"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cn_cit_period_reconciliation_runs" model="ir.actions.act_window">
        <field name="name">企业所得税账税勾稽</field>
        <field name="res_model">sudo.cn.cit.period.reconciliation.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cn_cit_period_reconciliation_run_search"/>
        <field name="context">{'search_default_current': 1}</field>
    </record>

    <record id="action_cn_cit_period_reconciliation_issues" model="ir.actions.act_window">
        <field name="name">企业所得税勾稽问题</field>
        <field name="res_model">sudo.cn.cit.period.reconciliation.issue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cn_cit_period_reconciliation_issue_search"/>
        <field name="context">{'search_default_current': 1}</field>
    </record>

    <record id="action_cn_cit_period_reconciliation_start" model="ir.actions.act_window">
        <field name="name">发起企业所得税账税勾稽</field>
        <field name="res_model">sudo.cn.cit.period.reconciliation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cn_cit_period_reconciliation_runs"
              name="企业所得税账税勾稽"
              parent="sudo_global_finance.menu_compliance_management"
              action="action_cn_cit_period_reconciliation_runs"
              sequence="60"
              groups="sudo_global_finance.group_compliance_user"/>
    <menuitem id="menu_cn_cit_period_reconciliation_start"
              name="发起企业所得税账税勾稽"
              parent="sudo_global_finance.menu_compliance_management"
              action="action_cn_cit_period_reconciliation_start"
              sequence="61"
              groups="sudo_global_finance.group_compliance_manager"/>
    <menuitem id="menu_cn_cit_period_reconciliation_issues"
              name="企业所得税勾稽问题"
              parent="sudo_global_finance.menu_compliance_management"
              action="action_cn_cit_period_reconciliation_issues"
              sequence="62"
              groups="sudo_global_finance.group_compliance_user"/>
</odoo>
