<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_compliance_workbench_search" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.search</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <search string="中国合规工作台">
                <field name="company_id"/>
                <filter name="cn_profiles" string="中国档案"
                        domain="[('country_id.code', '=', 'CN')]"/>
                <separator/>
                <filter name="group_company" string="按公司"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_compliance_workbench_list" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.list</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <list string="中国合规工作台" create="0" delete="0"
                  decoration-danger="cn_workbench_status == 'action_required'"
                  decoration-warning="cn_workbench_status in ('warning', 'limited', 'setup_required')"
                  decoration-success="cn_workbench_status == 'healthy'">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="name"/>
                <field name="cn_workbench_currency_id" invisible="1"/>
                <field name="cn_workbench_status" widget="badge"
                       decoration-danger="cn_workbench_status == 'action_required'"
                       decoration-warning="cn_workbench_status in ('warning', 'limited', 'setup_required')"
                       decoration-success="cn_workbench_status == 'healthy'"/>
                <field name="cn_workbench_period_label"/>
                <field name="cn_workbench_high_risk_count"/>
                <field name="cn_workbench_open_task_count"/>
                <field name="cn_workbench_overdue_task_count"/>
                <field name="cn_workbench_pending_review_count"/>
                <field name="cn_workbench_pending_tax_impact_count"/>
                <field name="cn_workbench_underpayment_amount"/>
                <field name="cn_workbench_reconciliation_issue_count"/>
                <field name="cn_workbench_next_action"/>
            </list>
        </field>
    </record>

    <record id="view_cn_compliance_workbench_kanban" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.kanban</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <kanban string="中国合规工作台" class="o_kanban_dashboard"
                    create="0" quick_create="0" sample="0">
                <field name="name"/>
                <field name="company_id"/>
                <field name="cn_workbench_status"/>
                <field name="cn_workbench_period_label"/>
                <field name="cn_workbench_next_action"/>
                <field name="cn_workbench_currency_id"/>
                <field name="cn_workbench_high_risk_count"/>
                <field name="cn_workbench_finding_count"/>
                <field name="cn_workbench_open_task_count"/>
                <field name="cn_workbench_overdue_task_count"/>
                <field name="cn_workbench_pending_review_count"/>
                <field name="cn_workbench_tax_impact_case_count"/>
                <field name="cn_workbench_pending_tax_impact_count"/>
                <field name="cn_workbench_underpayment_amount"/>
                <field name="cn_workbench_reconciliation_issue_count"/>
                <field name="cn_workbench_limitation_count"/>
                <field name="cn_workbench_scan_state"/>
                <field name="cn_workbench_risk_state"/>
                <field name="cn_workbench_remediation_state"/>
                <field name="cn_workbench_report_state"/>
                <field name="cn_workbench_evidence_state"/>
                <field name="cn_workbench_evidence_count"/>
                <field name="cn_workbench_verified_evidence_count"/>
                <field name="cn_workbench_latest_report_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click shadow-sm border-start border-4 #{record.cn_workbench_status.raw_value == 'action_required' ? 'border-danger' : record.cn_workbench_status.raw_value == 'healthy' ? 'border-success' : 'border-warning'}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold fs-5">
                                        <field name="company_id"/>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="cn_workbench_period_label"/>
                                    </div>
                                </div>
                                <span t-attf-class="badge rounded-pill #{record.cn_workbench_status.raw_value == 'action_required' ? 'text-bg-danger' : record.cn_workbench_status.raw_value == 'healthy' ? 'text-bg-success' : 'text-bg-warning'}">
                                    <field name="cn_workbench_status"/>
                                </span>
                            </div>

                            <div class="mt-3 text-muted">
                                <field name="cn_workbench_next_action"/>
                            </div>

                            <div class="mt-3">
                                <div class="text-muted small mb-2">端到端流程</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="object" name="action_cn_open_workbench_assessments"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">1 规则扫描</div>
                                        <field name="cn_workbench_scan_state" widget="badge"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_findings"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">2 风险识别</div>
                                        <field name="cn_workbench_risk_state" widget="badge"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_tasks"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">3 整改跟踪</div>
                                        <field name="cn_workbench_remediation_state" widget="badge"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_report_readiness"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">4 报告准备</div>
                                        <field name="cn_workbench_report_state" widget="badge"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_evidence_center"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">5 证据链</div>
                                        <field name="cn_workbench_evidence_state" widget="badge"/>
                                    </button>
                                </div>
                            </div>

                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_findings"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">高风险 / 总风险</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_high_risk_count"/>
                                            /
                                            <field name="cn_workbench_finding_count"/>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_tasks"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">逾期 / 未完成整改</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_overdue_task_count"/>
                                            /
                                            <field name="cn_workbench_open_task_count"/>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_tax_impacts"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">待量化 / 税务影响</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_pending_tax_impact_count"/>
                                            /
                                            <field name="cn_workbench_tax_impact_case_count"/>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_reports"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">已复核潜在少缴</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_underpayment_amount"/>
                                        </div>
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button type="object" name="action_cn_open_workbench_assessments"
                                        class="btn btn-primary btn-sm">
                                    规则扫描
                                </button>
                                <button type="object" name="action_cn_open_workbench_report_readiness"
                                        class="btn btn-outline-primary btn-sm">
                                    报告准备度
                                </button>
                                <button type="object" name="action_cn_open_workbench_evidence_center"
                                        class="btn btn-outline-primary btn-sm">
                                    证据中心
                                </button>
                                <button type="object" name="action_cn_open_workbench_vat_issues"
                                        class="btn btn-outline-secondary btn-sm">
                                    增值税勾稽
                                </button>
                                <button type="object" name="action_cn_open_workbench_cit_issues"
                                        class="btn btn-outline-secondary btn-sm">
                                    企业所得税勾稽
                                </button>
                                <button type="object" name="action_cn_open_workbench_iit_issues"
                                        class="btn btn-outline-secondary btn-sm">
                                    个税勾稽
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cn_compliance_workbench_form" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.form</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <form string="中国合规工作台" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="company_id" readonly="1"/></h1>
                        <h2><field name="cn_workbench_status" widget="badge" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="当前判断">
                            <field name="cn_workbench_period_label" readonly="1"/>
                            <field name="cn_workbench_next_action" readonly="1"/>
                            <field name="cn_workbench_last_assessment_id" readonly="1"/>
                            <field name="cn_workbench_latest_report_id" readonly="1"/>
                        </group>
                        <group string="风险与整改">
                            <field name="cn_workbench_finding_count" readonly="1"/>
                            <field name="cn_workbench_high_risk_count" readonly="1"/>
                            <field name="cn_workbench_pending_review_count" readonly="1"/>
                            <field name="cn_workbench_open_task_count" readonly="1"/>
                            <field name="cn_workbench_overdue_task_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="税务影响">
                            <field name="cn_workbench_currency_id" invisible="1"/>
                            <field name="cn_workbench_tax_impact_case_count" readonly="1"/>
                            <field name="cn_workbench_pending_tax_impact_count" readonly="1"/>
                            <field name="cn_workbench_underpayment_amount" readonly="1"/>
                        </group>
                        <group string="账税勾稽与限制">
                            <field name="cn_workbench_vat_issue_count" readonly="1"/>
                            <field name="cn_workbench_cit_issue_count" readonly="1"/>
                            <field name="cn_workbench_iit_issue_count" readonly="1"/>
                            <field name="cn_workbench_limitation_count" readonly="1"/>
                        </group>
                        <group string="流程总览">
                            <field name="cn_workbench_scan_state" readonly="1" widget="badge"/>
                            <field name="cn_workbench_risk_state" readonly="1" widget="badge"/>
                            <field name="cn_workbench_remediation_state" readonly="1" widget="badge"/>
                            <field name="cn_workbench_report_state" readonly="1" widget="badge"/>
                            <field name="cn_workbench_evidence_state" readonly="1" widget="badge"/>
                            <field name="cn_workbench_verified_evidence_count" readonly="1"/>
                            <field name="cn_workbench_evidence_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button name="action_cn_open_workbench_assessments" type="object"
                                string="查看规则扫描" class="btn-primary"/>
                        <button name="action_cn_open_workbench_findings" type="object"
                                string="查看风险事项"/>
                        <button name="action_cn_open_workbench_tasks" type="object"
                                string="查看整改任务"/>
                        <button name="action_cn_open_workbench_tax_impacts" type="object"
                                string="查看税务影响"/>
                        <button name="action_cn_open_workbench_reports" type="object"
                                string="查看正式报告"/>
                        <button name="action_cn_open_workbench_report_readiness" type="object"
                                string="查看报告准备度"/>
                        <button name="action_cn_open_workbench_evidence_center" type="object"
                                string="查看证据中心"/>
                        <button name="action_cn_open_workbench_vat_issues" type="object"
                                string="增值税勾稽问题"/>
                        <button name="action_cn_open_workbench_cit_issues" type="object"
                                string="企业所得税勾稽问题"/>
                        <button name="action_cn_open_workbench_iit_issues" type="object"
                                string="个税勾稽问题"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cn_compliance_workbench" model="ir.actions.act_window">
        <field name="name">中国合规工作台</field>
        <field name="res_model">sudo.compliance.profile</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_cn_compliance_workbench_search"/>
        <field name="domain">[('country_id.code', '=', 'CN')]</field>
        <field name="context">{'search_default_cn_profiles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">还没有中国合规档案</p>
            <p>先建立中国合规档案，再运行规则扫描、处理风险、推进整改并生成正式报告。</p>
        </field>
    </record>

    <menuitem id="menu_cn_compliance_workbench"
              name="中国合规工作台"
              parent="sudo_global_finance.menu_global_finance_root"
              action="action_cn_compliance_workbench"
              sequence="5"
              groups="sudo_global_finance.group_compliance_user"/>
</odoo>
