<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cn_compliance_workbench_search" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.search</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <search string="中国合规工作台">
                <field name="company_id"/>
                <filter name="cn_profiles" string="中国档案"
                        domain="[('country_id.code', '=', 'CN')]"/>
                <separator/>
                <filter name="group_company" string="按公司"
                        context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_cn_compliance_workbench_list" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.list</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <list string="中国合规工作台" create="0" delete="0"
                  decoration-danger="cn_workbench_status == 'action_required'"
                  decoration-warning="cn_workbench_status in ('warning', 'limited', 'setup_required')"
                  decoration-success="cn_workbench_status == 'healthy'">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="name"/>
                <field name="cn_workbench_currency_id" invisible="1"/>
                <field name="cn_workbench_status" widget="badge"
                       decoration-danger="cn_workbench_status == 'action_required'"
                       decoration-warning="cn_workbench_status in ('warning', 'limited', 'setup_required')"
                       decoration-success="cn_workbench_status == 'healthy'"/>
                <field name="cn_workbench_period_label"/>
                <field name="cn_workbench_data_state" widget="badge"
                       decoration-success="cn_workbench_data_state == 'ready'"
                       decoration-warning="cn_workbench_data_state == 'attention'"
                       decoration-danger="cn_workbench_data_state == 'blocked'"
                       decoration-muted="cn_workbench_data_state == 'not_started'"/>
                <field name="cn_workbench_ready_dataset_count"/>
                <field name="cn_workbench_dataset_count"/>
                <field name="cn_workbench_high_risk_count"/>
                <field name="cn_workbench_open_task_count"/>
                <field name="cn_workbench_overdue_task_count"/>
                <field name="cn_workbench_pending_review_count"/>
                <field name="cn_workbench_pending_tax_impact_count"/>
                <field name="cn_workbench_underpayment_amount"/>
                <field name="cn_workbench_reconciliation_issue_count"/>
                <field name="cn_workbench_next_action"/>
            </list>
        </field>
    </record>

    <record id="view_cn_compliance_workbench_kanban" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.kanban</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <kanban string="中国合规工作台" class="o_kanban_dashboard"
                    create="0" quick_create="0" sample="0">
                <field name="name"/>
                <field name="company_id"/>
                <field name="cn_workbench_status"/>
                <field name="cn_workbench_period_label"/>
                <field name="cn_workbench_next_action"/>
                <field name="cn_workbench_currency_id"/>
                <field name="cn_workbench_high_risk_count"/>
                <field name="cn_workbench_finding_count"/>
                <field name="cn_workbench_open_task_count"/>
                <field name="cn_workbench_overdue_task_count"/>
                <field name="cn_workbench_pending_review_count"/>
                <field name="cn_workbench_tax_impact_case_count"/>
                <field name="cn_workbench_pending_tax_impact_count"/>
                <field name="cn_workbench_underpayment_amount"/>
                <field name="cn_workbench_reconciliation_issue_count"/>
                <field name="cn_workbench_limitation_count"/>
                <field name="cn_workbench_data_state"/>
                <field name="cn_workbench_data_next_action"/>
                <field name="cn_workbench_dataset_count"/>
                <field name="cn_workbench_ready_dataset_count"/>
                <field name="cn_workbench_scan_state"/>
                <field name="cn_workbench_risk_state"/>
                <field name="cn_workbench_remediation_state"/>
                <field name="cn_workbench_rescan_state"/>
                <field name="cn_workbench_pending_rescan_count"/>
                <field name="cn_workbench_failed_rescan_count"/>
                <field name="cn_workbench_verified_remediation_count"/>
                <field name="cn_workbench_rescan_next_action"/>
                <field name="cn_workbench_report_state"/>
                <field name="cn_workbench_evidence_state"/>
                <field name="cn_workbench_evidence_count"/>
                <field name="cn_workbench_verified_evidence_count"/>
                <field name="cn_workbench_filing_archive_state"/>
                <field name="cn_workbench_filing_archive_next_action"/>
                <field name="cn_workbench_filing_archive_count"/>
                <field name="cn_workbench_sealed_filing_archive_count"/>
                <field name="cn_workbench_filing_archive_issue_count"/>
                <field name="cn_workbench_latest_report_id"/>
                <field name="cn_workbench_package_label"/>
                <field name="cn_workbench_scope_label"/>
                <field name="cn_workbench_vat_domain_state"/>
                <field name="cn_workbench_cit_domain_state"/>
                <field name="cn_workbench_iit_domain_state"/>
                <field name="cn_workbench_vat_next_action"/>
                <field name="cn_workbench_cit_next_action"/>
                <field name="cn_workbench_iit_next_action"/>
                <field name="cn_workbench_obligation_state"/>
                <field name="cn_workbench_obligation_next_action"/>
                <field name="cn_workbench_obligation_count"/>
                <field name="cn_workbench_applicable_obligation_count"/>
                <field name="cn_workbench_pending_obligation_count"/>
                <field name="cn_workbench_filing_obligation_count"/>
                <field name="cn_workbench_cross_border_state"/>
                <field name="cn_workbench_cross_border_basis"/>
                <field name="cn_workbench_cross_border_next_action"/>
                <field name="cn_workbench_cross_border_transaction_count"/>
                <field name="cn_workbench_cross_border_pending_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click shadow-sm border-start border-4 #{record.cn_workbench_status.raw_value == 'action_required' ? 'border-danger' : record.cn_workbench_status.raw_value == 'healthy' ? 'border-success' : 'border-warning'}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="text-muted small">
                                        <field name="cn_workbench_package_label"/>
                                    </div>
                                    <div class="fw-bold fs-5">
                                        <field name="company_id"/>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="cn_workbench_period_label"/>
                                    </div>
                                    <div class="text-muted small">
                                        <field name="cn_workbench_scope_label"/>
                                    </div>
                                </div>
                                <span t-attf-class="badge rounded-pill #{record.cn_workbench_status.raw_value == 'action_required' ? 'text-bg-danger' : record.cn_workbench_status.raw_value == 'healthy' ? 'text-bg-success' : 'text-bg-warning'}">
                                    <field name="cn_workbench_status"/>
                                </span>
                            </div>

                            <div class="mt-3 text-muted">
                                <field name="cn_workbench_next_action"/>
                            </div>

                            <button type="object" name="action_cn_open_workbench_obligations"
                                    class="btn btn-light w-100 text-start border mt-3">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">纳税义务适用性</div>
                                        <div class="text-muted small">
                                            <field name="cn_workbench_obligation_next_action"/>
                                        </div>
                                    </div>
                                    <field name="cn_workbench_obligation_state" widget="badge"
                                           decoration-success="cn_workbench_obligation_state == 'ready'"
                                           decoration-warning="cn_workbench_obligation_state == 'attention'"
                                           decoration-danger="cn_workbench_obligation_state == 'blocked'"
                                           decoration-muted="cn_workbench_obligation_state == 'not_started'"/>
                                </div>
                                <div class="row g-2 mt-2">
                                    <div class="col-3">
                                        <div class="text-muted small">候选</div>
                                        <div class="fw-bold"><field name="cn_workbench_obligation_count"/></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted small">已适用</div>
                                        <div class="fw-bold"><field name="cn_workbench_applicable_obligation_count"/></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted small">待确认</div>
                                        <div class="fw-bold"><field name="cn_workbench_pending_obligation_count"/></div>
                                    </div>
                                    <div class="col-3">
                                        <div class="text-muted small">申报类</div>
                                        <div class="fw-bold"><field name="cn_workbench_filing_obligation_count"/></div>
                                    </div>
                                </div>
                            </button>

                            <div class="row g-2 mt-3">
                                <div class="col-3">
                                    <button type="object" name="action_cn_open_workbench_vat_issues"
                                            class="btn btn-light w-100 text-start h-100 border">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold">增值税</div>
                                                <div class="text-muted small"><field name="cn_workbench_vat_next_action"/></div>
                                            </div>
                                            <field name="cn_workbench_vat_domain_state" widget="badge"
                                                   decoration-success="cn_workbench_vat_domain_state == 'ready'"
                                                   decoration-warning="cn_workbench_vat_domain_state == 'attention'"
                                                   decoration-danger="cn_workbench_vat_domain_state == 'blocked'"
                                                   decoration-muted="cn_workbench_vat_domain_state == 'not_started'"/>
                                        </div>
                                        <div class="fw-bold mt-2">
                                            <field name="cn_workbench_vat_issue_count"/>
                                            <span> 个勾稽问题</span>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-3">
                                    <button type="object" name="action_cn_open_workbench_cit_issues"
                                            class="btn btn-light w-100 text-start h-100 border">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold">企业所得税</div>
                                                <div class="text-muted small"><field name="cn_workbench_cit_next_action"/></div>
                                            </div>
                                            <field name="cn_workbench_cit_domain_state" widget="badge"
                                                   decoration-success="cn_workbench_cit_domain_state == 'ready'"
                                                   decoration-warning="cn_workbench_cit_domain_state == 'attention'"
                                                   decoration-danger="cn_workbench_cit_domain_state == 'blocked'"
                                                   decoration-muted="cn_workbench_cit_domain_state == 'not_started'"/>
                                        </div>
                                        <div class="fw-bold mt-2">
                                            <field name="cn_workbench_cit_issue_count"/>
                                            <span> 个勾稽问题</span>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-3">
                                    <button type="object" name="action_cn_open_workbench_iit_issues"
                                            class="btn btn-light w-100 text-start h-100 border">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold">个人所得税</div>
                                                <div class="text-muted small"><field name="cn_workbench_iit_next_action"/></div>
                                            </div>
                                            <field name="cn_workbench_iit_domain_state" widget="badge"
                                                   decoration-success="cn_workbench_iit_domain_state == 'ready'"
                                                   decoration-warning="cn_workbench_iit_domain_state == 'attention'"
                                                   decoration-danger="cn_workbench_iit_domain_state == 'blocked'"
                                                   decoration-muted="cn_workbench_iit_domain_state == 'not_started'"/>
                                        </div>
                                        <div class="fw-bold mt-2">
                                            <field name="cn_workbench_iit_issue_count"/>
                                            <span> 个勾稽问题</span>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-3">
                                    <button type="object" name="action_cn_open_workbench_cross_border_transactions"
                                            class="btn btn-light w-100 text-start h-100 border">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="fw-semibold">跨境/扣缴</div>
                                                <div class="text-muted small"><field name="cn_workbench_cross_border_next_action"/></div>
                                            </div>
                                            <field name="cn_workbench_cross_border_state" widget="badge"
                                                   decoration-success="cn_workbench_cross_border_state == 'ready'"
                                                   decoration-warning="cn_workbench_cross_border_state == 'attention'"
                                                   decoration-danger="cn_workbench_cross_border_state == 'blocked'"
                                                   decoration-muted="cn_workbench_cross_border_state == 'not_started'"/>
                                        </div>
                                        <div class="text-muted small mt-2">
                                            <field name="cn_workbench_cross_border_basis"/>
                                        </div>
                                        <div class="fw-bold mt-2">
                                            <field name="cn_workbench_cross_border_pending_count"/>
                                            <span> / </span>
                                            <field name="cn_workbench_cross_border_transaction_count"/>
                                            <span> pending / total</span>
                                        </div>
                                    </button>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="text-muted small mb-2">端到端流程</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="object" name="action_cn_open_workbench_data_readiness"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">0 数据准备</div>
                                        <field name="cn_workbench_data_state" widget="badge"
                                               decoration-success="cn_workbench_data_state == 'ready'"
                                               decoration-warning="cn_workbench_data_state == 'attention'"
                                               decoration-danger="cn_workbench_data_state == 'blocked'"
                                               decoration-muted="cn_workbench_data_state == 'not_started'"/>
                                        <div class="text-muted small mt-1">
                                            <field name="cn_workbench_ready_dataset_count"/>
                                            <span> / </span>
                                            <field name="cn_workbench_dataset_count"/>
                                            <span> 可扫描 / 总数据集</span>
                                        </div>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_assessments"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">1 规则扫描</div>
                                        <field name="cn_workbench_scan_state" widget="badge"
                                               decoration-success="cn_workbench_scan_state == 'ready'"
                                               decoration-warning="cn_workbench_scan_state == 'attention'"
                                               decoration-danger="cn_workbench_scan_state == 'blocked'"
                                               decoration-muted="cn_workbench_scan_state == 'not_started'"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_findings"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">2 风险识别</div>
                                        <field name="cn_workbench_risk_state" widget="badge"
                                               decoration-success="cn_workbench_risk_state == 'ready'"
                                               decoration-warning="cn_workbench_risk_state == 'attention'"
                                               decoration-danger="cn_workbench_risk_state == 'blocked'"
                                               decoration-muted="cn_workbench_risk_state == 'not_started'"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_tasks"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">3 整改跟踪</div>
                                        <field name="cn_workbench_remediation_state" widget="badge"
                                               decoration-success="cn_workbench_remediation_state == 'ready'"
                                               decoration-warning="cn_workbench_remediation_state == 'attention'"
                                               decoration-danger="cn_workbench_remediation_state == 'blocked'"
                                               decoration-muted="cn_workbench_remediation_state == 'not_started'"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_tasks"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">3.5 Verification Rescan</div>
                                        <field name="cn_workbench_rescan_state" widget="badge"
                                               decoration-success="cn_workbench_rescan_state == 'ready'"
                                               decoration-warning="cn_workbench_rescan_state == 'attention'"
                                               decoration-danger="cn_workbench_rescan_state == 'blocked'"
                                               decoration-muted="cn_workbench_rescan_state == 'not_started'"/>
                                        <div class="text-muted small mt-1">
                                            <field name="cn_workbench_pending_rescan_count"/>
                                            <span> pending / </span>
                                            <field name="cn_workbench_failed_rescan_count"/>
                                            <span> failed</span>
                                        </div>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_report_readiness"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">4 报告准备</div>
                                        <field name="cn_workbench_report_state" widget="badge"
                                               decoration-success="cn_workbench_report_state == 'ready'"
                                               decoration-warning="cn_workbench_report_state == 'attention'"
                                               decoration-danger="cn_workbench_report_state == 'blocked'"
                                               decoration-muted="cn_workbench_report_state == 'not_started'"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_evidence_center"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">5 证据链</div>
                                        <field name="cn_workbench_evidence_state" widget="badge"
                                               decoration-success="cn_workbench_evidence_state == 'ready'"
                                               decoration-warning="cn_workbench_evidence_state == 'attention'"
                                               decoration-danger="cn_workbench_evidence_state == 'blocked'"
                                               decoration-muted="cn_workbench_evidence_state == 'not_started'"/>
                                    </button>
                                    <button type="object" name="action_cn_open_workbench_filing_center"
                                            class="btn btn-light border text-start flex-fill">
                                        <div class="text-muted small">6 申报缴款档案</div>
                                        <field name="cn_workbench_filing_archive_state" widget="badge"
                                               decoration-success="cn_workbench_filing_archive_state == 'ready'"
                                               decoration-warning="cn_workbench_filing_archive_state == 'attention'"
                                               decoration-danger="cn_workbench_filing_archive_state == 'blocked'"
                                               decoration-muted="cn_workbench_filing_archive_state == 'not_started'"/>
                                    </button>
                                </div>
                            </div>

                            <button type="object" name="action_cn_open_workbench_filing_center"
                                    class="btn btn-light w-100 text-start border mt-3">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="fw-semibold">申报与缴款档案</div>
                                        <div class="text-muted small">
                                            <field name="cn_workbench_filing_archive_next_action"/>
                                        </div>
                                    </div>
                                    <field name="cn_workbench_filing_archive_state" widget="badge"
                                           decoration-success="cn_workbench_filing_archive_state == 'ready'"
                                           decoration-warning="cn_workbench_filing_archive_state == 'attention'"
                                           decoration-danger="cn_workbench_filing_archive_state == 'blocked'"
                                           decoration-muted="cn_workbench_filing_archive_state == 'not_started'"/>
                                </div>
                                <div class="row g-2 mt-2">
                                    <div class="col-4">
                                        <div class="text-muted small">受控档案</div>
                                        <div class="fw-bold"><field name="cn_workbench_filing_archive_count"/></div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small">已封存</div>
                                        <div class="fw-bold"><field name="cn_workbench_sealed_filing_archive_count"/></div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-muted small">待处理</div>
                                        <div class="fw-bold"><field name="cn_workbench_filing_archive_issue_count"/></div>
                                    </div>
                                </div>
                            </button>

                            <div class="row g-2 mt-3">
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_findings"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">高风险 / 总风险</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_high_risk_count"/>
                                            /
                                            <field name="cn_workbench_finding_count"/>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_tasks"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">逾期 / 未完成整改</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_overdue_task_count"/>
                                            /
                                            <field name="cn_workbench_open_task_count"/>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_tasks"
                                            class="btn btn-light w-100 text-start">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="text-muted small">Verification Rescan</div>
                                                <div class="fw-bold">
                                                    <field name="cn_workbench_pending_rescan_count"/>
                                                    <span> pending / </span>
                                                    <field name="cn_workbench_failed_rescan_count"/>
                                                    <span> failed / </span>
                                                    <field name="cn_workbench_verified_remediation_count"/>
                                                    <span> verified</span>
                                                </div>
                                            </div>
                                            <field name="cn_workbench_rescan_state" widget="badge"
                                                   decoration-success="cn_workbench_rescan_state == 'ready'"
                                                   decoration-warning="cn_workbench_rescan_state == 'attention'"
                                                   decoration-danger="cn_workbench_rescan_state == 'blocked'"
                                                   decoration-muted="cn_workbench_rescan_state == 'not_started'"/>
                                        </div>
                                        <div class="text-muted small mt-2">
                                            <field name="cn_workbench_rescan_next_action"/>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_tax_impacts"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">待量化 / 税务影响</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_pending_tax_impact_count"/>
                                            /
                                            <field name="cn_workbench_tax_impact_case_count"/>
                                        </div>
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="object" name="action_cn_open_workbench_reports"
                                            class="btn btn-light w-100 text-start">
                                        <div class="text-muted small">已复核潜在少缴</div>
                                        <div class="fw-bold">
                                            <field name="cn_workbench_underpayment_amount"/>
                                        </div>
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <button type="object" name="action_cn_open_workbench_data_readiness"
                                        class="btn btn-outline-primary btn-sm">
                                    数据准备中心
                                </button>
                                <button type="object" name="action_cn_open_workbench_obligations"
                                        class="btn btn-outline-primary btn-sm">
                                    纳税义务
                                </button>
                                <button type="object" name="action_cn_open_workbench_assessments"
                                        class="btn btn-primary btn-sm">
                                    规则扫描
                                </button>
                                <button type="object" name="action_cn_open_workbench_report_readiness"
                                        class="btn btn-outline-primary btn-sm">
                                    报告准备度
                                </button>
                                <button type="object" name="action_cn_open_workbench_evidence_center"
