    <record id="view_cn_compliance_workbench_form" model="ir.ui.view">
        <field name="name">sudo.compliance.profile.cn.workbench.form</field>
        <field name="model">sudo.compliance.profile</field>
        <field name="arch" type="xml">
            <form string="中国合规工作台" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="company_id" readonly="1"/></h1>
                        <h2>
                            <field name="cn_workbench_status" widget="badge" readonly="1"
                                   decoration-success="cn_workbench_status == 'healthy'"
                                   decoration-warning="cn_workbench_status in ('warning', 'setup_required')"
                                   decoration-danger="cn_workbench_status == 'action_required'"
                                   decoration-muted="cn_workbench_status == 'limited'"/>
                        </h2>
                    </div>
                    <group>
                        <group string="当前判断">
                            <field name="cn_workbench_period_label" readonly="1"/>
                            <field name="cn_workbench_next_action" readonly="1"/>
                            <field name="cn_workbench_last_assessment_id" readonly="1"/>
                            <field name="cn_workbench_latest_report_id" readonly="1"/>
                        </group>
                        <group string="风险与整改">
                            <field name="cn_workbench_finding_count" readonly="1"/>
                            <field name="cn_workbench_high_risk_count" readonly="1"/>
                            <field name="cn_workbench_pending_review_count" readonly="1"/>
                            <field name="cn_workbench_open_task_count" readonly="1"/>
                            <field name="cn_workbench_overdue_task_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="税务影响">
                            <field name="cn_workbench_currency_id" invisible="1"/>
                            <field name="cn_workbench_tax_impact_case_count" readonly="1"/>
                            <field name="cn_workbench_pending_tax_impact_count" readonly="1"/>
                            <field name="cn_workbench_underpayment_amount" readonly="1"/>
                        </group>
                        <group string="账税勾稽与限制">
                            <field name="cn_workbench_vat_issue_count" readonly="1"/>
                            <field name="cn_workbench_cit_issue_count" readonly="1"/>
                            <field name="cn_workbench_iit_issue_count" readonly="1"/>
                            <field name="cn_workbench_limitation_count" readonly="1"/>
                        </group>
                        <group string="纳税义务适用性">
                            <field name="cn_workbench_obligation_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_obligation_state == 'ready'"
                                   decoration-warning="cn_workbench_obligation_state == 'attention'"
                                   decoration-danger="cn_workbench_obligation_state == 'blocked'"
                                   decoration-muted="cn_workbench_obligation_state == 'not_started'"/>
                            <field name="cn_workbench_obligation_next_action" readonly="1"/>
                            <field name="cn_workbench_obligation_count" readonly="1"/>
                            <field name="cn_workbench_applicable_obligation_count" readonly="1"/>
                            <field name="cn_workbench_pending_obligation_count" readonly="1"/>
                            <field name="cn_workbench_filing_obligation_count" readonly="1"/>
                        </group>
                        <group string="流程总览">
                            <field name="cn_workbench_scan_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_scan_state == 'ready'"
                                   decoration-warning="cn_workbench_scan_state == 'attention'"
                                   decoration-danger="cn_workbench_scan_state == 'blocked'"
                                   decoration-muted="cn_workbench_scan_state == 'not_started'"/>
                            <field name="cn_workbench_risk_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_risk_state == 'ready'"
                                   decoration-warning="cn_workbench_risk_state == 'attention'"
                                   decoration-danger="cn_workbench_risk_state == 'blocked'"
                                   decoration-muted="cn_workbench_risk_state == 'not_started'"/>
                            <field name="cn_workbench_remediation_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_remediation_state == 'ready'"
                                   decoration-warning="cn_workbench_remediation_state == 'attention'"
                                   decoration-danger="cn_workbench_remediation_state == 'blocked'"
                                   decoration-muted="cn_workbench_remediation_state == 'not_started'"/>
                            <field name="cn_workbench_rescan_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_rescan_state == 'ready'"
                                   decoration-warning="cn_workbench_rescan_state == 'attention'"
                                   decoration-danger="cn_workbench_rescan_state == 'blocked'"
                                   decoration-muted="cn_workbench_rescan_state == 'not_started'"/>
                            <field name="cn_workbench_rescan_next_action" readonly="1"/>
                            <field name="cn_workbench_pending_rescan_count" readonly="1"/>
                            <field name="cn_workbench_failed_rescan_count" readonly="1"/>
                            <field name="cn_workbench_verified_remediation_count" readonly="1"/>
                            <field name="cn_workbench_report_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_report_state == 'ready'"
                                   decoration-warning="cn_workbench_report_state == 'attention'"
                                   decoration-danger="cn_workbench_report_state == 'blocked'"
                                   decoration-muted="cn_workbench_report_state == 'not_started'"/>
                            <field name="cn_workbench_evidence_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_evidence_state == 'ready'"
                                   decoration-warning="cn_workbench_evidence_state == 'attention'"
                                   decoration-danger="cn_workbench_evidence_state == 'blocked'"
                                   decoration-muted="cn_workbench_evidence_state == 'not_started'"/>
                            <field name="cn_workbench_verified_evidence_count" readonly="1"/>
                            <field name="cn_workbench_evidence_count" readonly="1"/>
                        </group>
                        <group string="申报与缴款档案">
                            <field name="cn_workbench_filing_archive_state" readonly="1" widget="badge"
                                   decoration-success="cn_workbench_filing_archive_state == 'ready'"
                                   decoration-warning="cn_workbench_filing_archive_state == 'attention'"
                                   decoration-danger="cn_workbench_filing_archive_state == 'blocked'"
                                   decoration-muted="cn_workbench_filing_archive_state == 'not_started'"/>
                            <field name="cn_workbench_filing_archive_next_action" readonly="1"/>
                            <field name="cn_workbench_filing_archive_count" readonly="1"/>
                            <field name="cn_workbench_sealed_filing_archive_count" readonly="1"/>
                            <field name="cn_workbench_filing_archive_issue_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button name="action_cn_open_workbench_data_readiness" type="object"
                                string="查看数据准备中心" class="btn-secondary"/>
                        <button name="action_cn_open_workbench_obligations" type="object"
                                string="查看纳税义务"/>
                        <button name="action_cn_open_workbench_assessments" type="object"
                                string="查看规则扫描" class="btn-primary"/>
                        <button name="action_cn_open_workbench_findings" type="object"
                                string="查看风险事项"/>
                        <button name="action_cn_open_workbench_tasks" type="object"
                                string="查看整改任务"/>
                        <button name="action_cn_open_workbench_tax_impacts" type="object"
                                string="查看税务影响"/>
                        <button name="action_cn_open_workbench_reports" type="object"
                                string="查看正式报告"/>
                        <button name="action_cn_open_workbench_report_readiness" type="object"
                                string="查看报告准备度"/>
                        <button name="action_cn_open_workbench_evidence_center" type="object"
                                string="查看证据中心"/>
                        <button name="action_cn_open_workbench_filing_center" type="object"
                                string="查看申报缴款档案"/>
                        <button name="action_cn_open_workbench_vat_issues" type="object"
                                string="增值税勾稽问题"/>
                        <button name="action_cn_open_workbench_cit_issues" type="object"
                                string="企业所得税勾稽问题"/>
                        <button name="action_cn_open_workbench_iit_issues" type="object"
                                string="个税勾稽问题"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

